#. type: Plain text
#: text/upstream/general.ent:16
#, no-wrap
msgid ""
"<!-- Editing  up to the line of ==== should be enough\n"
"     to generate a book for development, release, or rc-->\n"
"<!ENTITY % development \"INCLUDE\"><!-- set to INCLUDE for development,\n"
"                                      set to IGNORE for release or rc -->\n"
"<!ENTITY % release     \"IGNORE\"> <!-- set to INCLUDE for release,\n"
"                                      set to IGNORE for development or rc "
"-->\n"
"<!ENTITY % rc          \"IGNORE\"> <!-- set to INCLUDE for rc,\n"
"                                      set to IGNORE for development or\n"
"                                       release -->\n"
"<!ENTITY % relnum \"12.3\"><!-- must be given for release or rc -->\n"
"<!ENTITY % reldate \"March 5th, 2025\"><!-- must ve given for release or rc "
"-->\n"
"<!ENTITY % crdate \"1999-2026\"><!-- must ve given for release or rc -->\n"
"<!ENTITY % rcnum  \"0\"><!-- must be given only for rc -->\n"
"<!-- ================================================================== -->\n"
"<!-- Do not change anything below unless the www or book layouts change -->\n"
msgstr ""
"<!-- Editar-se até a linha do ==== deveria ser suficiente para gerar um\n"
"     livro para desenvolvimento, lançamento ou candidato a lançamento -->\n"
"<!ENTITY % development \"INCLUDE\"><!-- configurar para INCLUDE para\n"
"desenvolvimento; configurar para IGNORE para lançamento ou candidato a\n"
"lançamento -->\n"
"<!ENTITY % release     \"IGNORE\"><!-- configurar para INCLUDE para\n"
"lançamento; configurar para IGNORE para desenvolvimento ou candidato a\n"
"lançamento -->\n"
"<!ENTITY % rc          \"IGNORE\"><!-- configurar para INCLUDE para "
"candidato\n"
"a lançamento; configurar para IGNORE para desenvolvimento ou lançamento "
"-->\n"
"<!ENTITY % relnum \"13.0\"><!-- precisa ser fornecida para lançamento ou "
"para\n"
"candidato a lançamento -->\n"
"<!ENTITY % reldate \"05 de março de 2026\"><!-- precisa ser fornecida para\n"
"lançamento ou para candidato a lançamento -->\n"
"<!ENTITY % crdate \"1999-2026\"><!-- precisa ser fornecida para lançamento "
"ou\n"
"para candidato a lançamento -->\n"
"<!ENTITY % rcnum  \"0\"><!-- precisa ser fornecida somente para candidato a\n"
"lançamento -->\n"
"<!-- ================================================================== -->\n"
"<!-- Não mude nada abaixo, a menos que os esquemas da www ou os do\n"
"      livro mudem -->\n"

#. type: Plain text
#: text/upstream/general.ent:20
msgid ""
"<!-- Automatically generated by git-version.sh. Used for release or dev --> "
"<!ENTITY % conditional-entities SYSTEM \"conditional.ent\"> "
"%conditional-entities;"
msgstr ""
"<!-- Gerado automaticamente pelo git-version.sh. Usado para lançamento\n"
"ou para desenvolvimento -->\n"
"<!ENTITY % conditional-entities SYSTEM \"conditional.ent\"> "
"%conditional-entities;"

#. type: Plain text
#: text/upstream/general.ent:39
#, no-wrap
msgid ""
"<![ %development; [\n"
"<!-- version info automatically generated by git -->\n"
"<!ENTITY % version-entities SYSTEM \"version.ent\">\n"
"%version-entities;\n"
"<![ %sysv; [\n"
"<!ENTITY short-version   \"svn\">    <!-- Used below in &blfs-book; -->\n"
"<!ENTITY errata          \"&lfs-root;lfs/errata/development/\">\n"
"]]>\n"
"<![ %systemd; [\n"
"<!ENTITY short-version  \"systemd\"> <!-- Used below in &blfs-book; -->\n"
"<!ENTITY errata          \"&lfs-root;lfs/errata/systemd/\">\n"
"]]>\n"
"<!ENTITY generic-version \"development\"> <!-- Used below in\n"
"                                             &patches-root;,\n"
"                                             &donwloads-root;, and\n"
"                                             &test-results; -->\n"
"<!ENTITY os-release-type \"development\"> <!-- used by /etc/os-release -->\n"
"]]><!-- End %development -->\n"
msgstr ""
"<![ %development; [\n"
"<!-- informação de versão gerada automaticamente pelo git -->\n"
"<!ENTITY % version-entities SYSTEM \"version.ent\"> %version-entities;\n"
"<![ %sysv; [\n"
"<!ENTITY short-version   \"svn\">    <!-- Usada abaixo no &blfs-book; -->\n"
"<!ENTITY errata          \"&lfs-root;lfs/errata/development/\">\n"
"]]>\n"
"<![ %systemd; [\n"
"<!ENTITY short-version  \"systemd\"> <!-- Usada abaixo no &blfs-book; -->\n"
"<!ENTITY errata          \"&lfs-root;lfs/errata/systemd/\">\n"
"]]>\n"
"<!ENTITY generic-version \"development\"> <!-- Usada abaixo no\n"
"\t\t\t\t\t   &patches-root;,\n"
"\t\t\t\t\t   &donwloads-root; e no\n"
"\t\t\t\t\t   &test-results; -->\n"
"<!ENTITY os-release-type \"development\"> <!-- usada por /etc/os-release "
"-->\n"
"]]><!-- Fim %development -->\n"

#. type: Plain text
#: text/upstream/general.ent:58
#, no-wrap
msgid ""
"<![ %release; [\n"
"<![ %sysv; [\n"
"<!ENTITY version         \"%relnum;\">\n"
"<!ENTITY short-version   \"%relnum;\">  <!-- Used below in &blfs-book; -->\n"
"]]>\n"
"<![ %systemd; [\n"
"<!ENTITY version         \"%relnum;-systemd\">\n"
"<!ENTITY short-version   \"%relnum;-systemd\"> <!-- Used below in "
"&blfs-book; -->\n"
"]]>\n"
"<!ENTITY errata          \"&lfs-root;lfs/errata/&version;/\">\n"
"<!ENTITY generic-version \"%relnum;\"> <!-- Used below in\n"
"                                          &patches-root;,\n"
"                                          &donwloads-root;, and\n"
"                                          &test-results; -->\n"
"<!ENTITY releasedate     \"%reldate;\">\n"
"<!ENTITY copyrightdate   \"%crdate;\">\n"
"<!ENTITY os-release-type \"stable\"> <!-- used by /etc/os-release -->\n"
"]]>\n"
msgstr ""
"<![ %release; [\n"
"<![ %sysv; [\n"
"<!ENTITY version         \"%relnum;\">\n"
"<!ENTITY short-version   \"%relnum;\">  <!-- Usada abaixo no\n"
"\t\t\t\t\t &blfs-book; -->\n"
"]]>\n"
"<![ %systemd; [\n"
"<!ENTITY version         \"%relnum;-systemd\">\n"
"<!ENTITY short-version   \"%relnum;-systemd\"> <!-- Usada abaixo no\n"
"\t\t\t\t\t\t&blfs-book; -->\n"
"]]>\n"
"<!ENTITY errata          \"&lfs-root;lfs/errata/&version;/\">\n"
"<!ENTITY generic-version \"%relnum;\"> <!-- Usada abaixo no\n"
"\t\t\t\t\t&patches-root;, &donwloads-root;\n"
"\t\t\t\t\te no &test-results; -->\n"
"<!ENTITY releasedate     \"%reldate;\">\n"
"<!ENTITY copyrightdate   \"%crdate;\">\n"
"<!ENTITY os-release-type \"stable\"> <!-- usada por /etc/os-release -->\n"
"]]>\n"

