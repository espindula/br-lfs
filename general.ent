<!-- Editar-se até a linha do ==== deveria ser suficiente para gerar um
     livro para desenvolvimento, lançamento ou candidato a lançamento -->
<!ENTITY % development "INCLUDE"><!-- configurar para INCLUDE para
				    desenvolvimento; configurar para
				    IGNORE para lançamento ou candidato
				    a lançamento -->
<!ENTITY % release     "IGNORE"><!-- configurar para INCLUDE para
				    lançamento; configurar para IGNORE
				    para desenvolvimento ou candidato a
				    lançamento -->
<!ENTITY % rc          "IGNORE"><!-- configurar para INCLUDE para
				   candidato a lançamento; configurar
				   para IGNORE para desenvolvimento ou
				   lançamento -->
<!ENTITY % relnum "12.3"><!-- precisa ser fornecida para lançamento
			    ou para candidato a lançamento -->
<!ENTITY % reldate "March 5th, 2025"><!-- precisa ser fornecida para
					lançamento ou para candidato a
					lançamento -->
<!ENTITY % crdate "1999-2025"><!-- precisa ser fornecida para
				 lançamento ou para candidato a
				 lançamento -->
<!ENTITY % rcnum  "0"><!-- precisa ser fornecida somente para
			 candidato a lançamento -->
<!-- ================================================================== -->
<!-- Não mude nada abaixo, a menos que os esquemas da www ou os do
      livro mudem -->

<!-- Gerado automaticamente pelo git-version.sh. Usado para lançamento
ou para desenvolvimento --><!ENTITY % conditional-entities SYSTEM
"conditional.ent"> %conditional-entities;

<![ %development; [
<!-- informação de versão gerada automaticamente pelo git -->
<!ENTITY % version-entities SYSTEM "version.ent">
%version-entities;
<![ %sysv; [
<!ENTITY short-version   "svn">    <!-- Usada abaixo no &blfs-book; -->
<!ENTITY errata          "&lfs-root;lfs/errata/development/">
]]>
<![ %systemd; [
<!ENTITY short-version  "systemd"> <!-- Usada abaixo no &blfs-book; -->
<!ENTITY errata          "&lfs-root;lfs/errata/systemd/">
]]>
<!ENTITY generic-version "development"> <!-- Usada abaixo no
					   &patches-root;,
					   &donwloads-root; e no
					   &test-results; -->
<!ENTITY os-release-type "development"> <!-- usada por /etc/os-release -->
]]><!-- Fim %development -->

<![ %release; [
<![ %sysv; [
<!ENTITY version         "%relnum;">
<!ENTITY short-version   "%relnum;">  <!-- Usada abaixo no
					 &blfs-book; -->
]]>
<![ %systemd; [
<!ENTITY version         "%relnum;-systemd">
<!ENTITY short-version   "%relnum;-systemd"> <!-- Usada abaixo no
						&blfs-book; -->
]]>
<!ENTITY errata          "&lfs-root;lfs/errata/&version;/">
<!ENTITY generic-version "%relnum;"> <!-- Usada abaixo no
					&patches-root;, &donwloads-root;
					e no &test-results; -->
<!ENTITY releasedate     "%reldate;">
<!ENTITY copyrightdate   "%crdate;">
<!ENTITY os-release-type "stable"> <!-- usada por /etc/os-release -->
]]>

<![ %rc; [
<![ %sysv; [
<!ENTITY version         "%relnum;-rc%rcnum;">
<!ENTITY short-version   "svn">  <!-- Usada abaixo no &blfs-book; -->
]]>
<![ %systemd; [
<!ENTITY version         "%relnum;-systemd-rc%rcnum;">
<!ENTITY short-version   "systemd">  <!-- Usada abaixo no &blfs-book; -->
]]>
<!ENTITY errata          "&lfs-root;lfs/errata/&version;/">
<!ENTITY generic-version "%relnum;-rc%rcnum;"> <!-- Usada abaixo no
						  &patches-root;,
						  &downloads-root; e no
						  &test-results; -->
<!ENTITY releasedate     "%reldate;">
<!ENTITY copyrightdate   "%crdate;">
<!ENTITY os-release-type "development"> <!-- usada por /etc/os-release -->
]]>

<![ %sysv; [
<!ENTITY wget-list       "wget-list-sysv">
]]>
<![ %systemd; [
<!ENTITY wget-list       "wget-list-systemd">
]]>

<!ENTITY lfs-root        "https://www.linuxfromscratch.org/">
<!ENTITY blfs-root       "&lfs-root;blfs/">
<!ENTITY blfs-book       "&blfs-root;view/&short-version;/">
<!ENTITY faq-root        "&lfs-root;faq/">
<!ENTITY hints-root      "&lfs-root;hints/downloads/files/">
<!ENTITY hints-index     "&lfs-root;hints/list.html">
<!ENTITY patches-root    "&lfs-root;patches/lfs/&generic-version;/">
<!-- Usadas somente para sysv (lfs-bootscripts): -->
<!ENTITY downloads-root  "&lfs-root;lfs/downloads/&generic-version;/">
<!ENTITY livecd-root     "&lfs-root;livecd/">
<!ENTITY test-results    "&lfs-root;lfs/build-logs/&generic-version;/">
<!ENTITY secadv          "&lfs-root;lfs/advisories/">

<!-- Fim de linha do 5.4 será em dezembro de 2025;
	 assim, para o LFS 12.5, nós possivelmente consideraremos mover para
5.10. -->
<!ENTITY min-kernel      "5.4">

<!--
<!ENTITY patches-rootd   "&lfs-root;patches/lfs/&generic-versiond;/">
<!ENTITY downloads-rootd "&lfs-root;lfs/downloads/&generic-versiond;/">
<!ENTITY test-resultsd   "&lfs-root;lfs/build-logs/&generic-versiond;/">
<!ENTITY erratad         "&lfs-root;lfs/errata/&generic-versiond;/">
-->
<!ENTITY lfs-ticket-root "https://wiki.linuxfromscratch.org/lfs/ticket/">
<!ENTITY blfs-ticket-root "https://wiki.linuxfromscratch.org/blfs/ticket/">

<!ENTITY anduin-sources "https://anduin.linuxfromscratch.org/LFS">

<!ENTITY buildtime       "Tempo aproximado de construção">
<!ENTITY diskspace       "Espaço exigido em disco">
<!ENTITY dependencies    "A Instalação depende de">
<!ENTITY runtime         "Exigido em tempo de execução">
<!ENTITY testsuites      "A suíte de teste depende de">
<!ENTITY before          "Precisa ser instalado antes de">
<!ENTITY external        "Dependências opcionais">

<!--<!ENTITY gnu             "https://ftp.gnu.org/gnu/">-->
<!ENTITY gnu             "https://ftpmirror.gnu.org/">
<!ENTITY gnu-software    "https://www.gnu.org/software/">
<!ENTITY alpha-gnu       "https://alpha.gnu.org/gnu/">
<!ENTITY kernel          "https://www.kernel.org/pub/">
<!ENTITY sourceforge     "https://prdownloads.sourceforge.net/">
<!ENTITY savannah        "https://download.savannah.gnu.org">
<!ENTITY savannah-nongnu "https://savannah.nongnu.org">
<!ENTITY github          "https://github.com">
<!ENTITY pypi-home       "https://pypi.org/project">
<!ENTITY pypi-src        "https://pypi.org/packages/source">
<!ENTITY man             "https://man.archlinux.org/man/">

<!ENTITY root            "<systemitem class='username'>root</systemitem>">
<!ENTITY lfs-user        "<systemitem class='username'>lfs</systemitem>">
<!ENTITY lfs-username    "<userinput remap='user'>lfs</userinput>">
<!ENTITY lfs-groupname   "<userinput remap='group'>lfs</userinput>">
<!ENTITY devtmpfs        "<systemitem class='filesystem'>devtmpfs</systemitem>">
<!ENTITY fstab           "<filename>/etc/fstab</filename>">
<!ENTITY boot-dir        "<filename class='directory'>/boot</filename>">
<!ENTITY ch-final        "<xref linkend='chapter-building-system'/>">
<!ENTITY ch-tmp-cross    "<xref linkend='chapter-temporary-tools'/>">
<!ENTITY ch-tmp-chroot   "<xref linkend='chapter-chroot-temporary-tools'/>">

<!ENTITY % packages-entities SYSTEM "packages.ent"> %packages-entities;

<!ENTITY % patches-entities SYSTEM "patches.ent"> %patches-entities;
