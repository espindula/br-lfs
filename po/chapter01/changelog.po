#. type: Content of: <sect1><title>
#: lfs-en/chapter01/changelog.xml:11
#, xml-text
msgid "Changelog"
msgstr "Registro das Mudanças"

#. type: Content of: <sect1><para>
#: lfs-en/chapter01/changelog.xml:13
#, xml-text
msgid ""
"This is version &version; of the Linux From Scratch book, dated "
"&releasedate;. If this book is more than six months old, a newer and better "
"version is probably already available. To find out, please check one of the "
"mirrors via <ulink url=\"&lfs-root;mirrors.html\"/>."
msgstr ""
"Esta é a versão &version; do livro Linux From Scratch, datada de "
"&releasedate;. Se este livro for mais antigo que seis meses, uma versão mais"
" nova e melhor provavelmente já está disponível. Para descobrir, por favor "
"verifique um dos espelhos via <ulink url=\"&lfs-root;mirrors.html\"/>."

#. type: Content of: <sect1><para>
#: lfs-en/chapter01/changelog.xml:18
#, xml-text
msgid ""
"Below is a list of changes made since the previous release of the book."
msgstr ""
"Abaixo está uma lista das mudanças feitas desde o lançamento anterior do "
"livro."

