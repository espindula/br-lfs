#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter06/m4.xml:44
#, xml-text
msgid "Installation of M4"
msgstr "Instalação do M4"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/m4.xml:46
#, xml-text
msgid "First, make some fixes introduced by glibc-2.43:"
msgstr "Primeiro, faça algumas correções introduzidas por glibc-2.43:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/m4.xml:48
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -r '/_GL_EXTERN_C/s/w?memchr|bsearch/(&amp;)/' \\\n"
"    -i $(find -name \\*.in.h)</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -r '/_GL_EXTERN_C/s/w?memchr|bsearch/(&amp;)/' "
"\\\n"
"    -i $(find -name \\*.in.h)</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/m4.xml:51
#, xml-text
msgid "Prepare M4 for compilation:"
msgstr "Prepare o M4 para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/m4.xml:53
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr   \\\n"
"            --host=$LFS_TGT \\\n"
"            --build=$(build-aux/config.guess)</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr   \\\n"
"            --host=$LFS_TGT \\\n"
"            --build=$(build-aux/config.guess)</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/m4.xml:57
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/m4.xml:59
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/m4.xml:61
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/m4.xml:63
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make DESTDIR=$LFS install</userinput>"
msgstr "<userinput remap=\"install\">make DESTDIR=$LFS install</userinput>"

