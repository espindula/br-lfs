#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter06/bash.xml:44
#, xml-text
msgid "Installation of Bash"
msgstr "Instalação do Bash"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/bash.xml:46
#, xml-text
msgid "Prepare Bash for compilation:"
msgstr "Prepare o Bash para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/bash.xml:48
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr                      \\\n"
"            --build=$(sh support/config.guess) \\\n"
"            --host=$LFS_TGT                    \\\n"
"            --without-bash-malloc              \\\n"
"            --docdir=/usr/share/doc/bash-&bash-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr"
"                      \\\n"
"            --build=$(sh support/config.guess) \\\n"
"            --host=$LFS_TGT                    \\\n"
"            --without-bash-malloc              \\\n"
"            --docdir=/usr/share/doc/bash-&bash-version;</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter06/bash.xml:55
#, xml-text
msgid "The meaning of the configure options:"
msgstr "O significado das opções do configure:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter06/bash.xml:58
#, xml-text
msgid "<parameter>--without-bash-malloc</parameter>"
msgstr "<parameter>--without-bash-malloc</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter06/bash.xml:60
#, xml-text
msgid ""
"This option turns off the use of Bash's memory allocation "
"(<function>malloc</function>) function which is known to cause segmentation "
"faults. By turning this option off, Bash will use the "
"<function>malloc</function> functions from Glibc which are more stable."
msgstr ""
"Essa opção desliga o uso da função de alocação de memória do Bash "
"(<function>malloc</function>) a qual é conhecida por causar falhas de "
"segmentação. Ao se desligar essa opção, o Bash usará as funções "
"<function>malloc</function> originárias da Glibc que são mais estáveis."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/bash.xml:70
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/bash.xml:72
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/bash.xml:74
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/bash.xml:76
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make DESTDIR=$LFS install</userinput>"
msgstr "<userinput remap=\"install\">make DESTDIR=$LFS install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/bash.xml:78
#, xml-text
msgid ""
"Make a link for the programs that use <command>sh</command> for a shell:"
msgstr ""
"Faça um link para os aplicativos que usam <command>sh</command> para um "
"shell:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/bash.xml:81
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">ln -sv bash $LFS/bin/sh</userinput>"
msgstr "<userinput remap=\"install\">ln -sv bash $LFS/bin/sh</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/bash.xml:88
#, xml-text
msgid ""
