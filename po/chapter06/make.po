#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter06/make.xml:43
#, xml-text
msgid "Installation of Make"
msgstr "Instalação do Make"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/make.xml:45
#, xml-text
msgid "Prepare Make for compilation:"
msgstr "Prepare o Make para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/make.xml:47
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr   \\\n"
"            --host=$LFS_TGT \\\n"
"            --build=$(build-aux/config.guess)</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr   \\\n"
"            --host=$LFS_TGT \\\n"
"            --build=$(build-aux/config.guess)</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/make.xml:51
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/make.xml:53
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/make.xml:55
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/make.xml:57
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make DESTDIR=$LFS install</userinput>"
msgstr "<userinput remap=\"install\">make DESTDIR=$LFS install</userinput>"

