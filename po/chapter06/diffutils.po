#, xml-text
#~ msgid ""
#~ "When Diffutils is being configured, it checks to see if it is being cross "
#~ "compiled. If it is, configuration fails. Since we are cross compiling, "
#~ "comment out the specific lines that perform that test now:"
#~ msgstr ""
#~ "Quando Diffutils está sendo construído, ele verifica para ver se está sendo "
#~ "compilado cruzadamente. Se estiver, a configuração falha. Como nós estamos "
#~ "compilando cruzadamente, comente as linhas específicas que realizam esse "
#~ "teste agora:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed -e '46252,+3 s/^/#/' \\\n"
#~ "    -e '46596,+3 s/^/#/' \\\n"
#~ "    -i configure</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">sed -e '46252,+3 s/^/#/' \\\n"
#~ "    -e '46596,+3 s/^/#/' \\\n"
#~ "    -i configure</userinput>"
