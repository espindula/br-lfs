#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter06/coreutils.xml:44
#, xml-text
msgid "Installation of Coreutils"
msgstr "Instalação do Coreutils"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/coreutils.xml:46
#, xml-text
msgid "Prepare Coreutils for compilation:"
msgstr "Prepare o Coreutils para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/coreutils.xml:48
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr                     \\\n"
"            --host=$LFS_TGT                   \\\n"
"            --build=$(build-aux/config.guess) \\\n"
"            --enable-install-program=hostname \\\n"
"            --enable-no-install-program=kill,uptime</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr                     \\\n"
"            --host=$LFS_TGT                   \\\n"
"            --build=$(build-aux/config.guess) \\\n"
"            --enable-install-program=hostname \\\n"
"            --enable-no-install-program=kill,uptime</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter06/coreutils.xml:55
#, xml-text
msgid "The meaning of the configure options:"
msgstr "O significado das opções do configure:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter06/coreutils.xml:58
#, xml-text
msgid "<envar>--enable-install-program=hostname</envar>"
msgstr "<envar>--enable-install-program=hostname</envar>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter06/coreutils.xml:60
#, xml-text
msgid ""
"This enables the <command>hostname</command> binary to be built and "
"installed &ndash; it is disabled by default but is required by the Perl test"
" suite."
msgstr ""
"Isso habilita o binário <command>hostname</command> para ser construído e "
"instalado &ndash; ele é desabilitado por padrão, porém é exigido pela suíte "
"de teste do Perl."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/coreutils.xml:68
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/coreutils.xml:70
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/coreutils.xml:72
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/coreutils.xml:74
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make DESTDIR=$LFS install</userinput>"
msgstr "<userinput remap=\"install\">make DESTDIR=$LFS install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/coreutils.xml:83
#, xml-text
msgid ""
"Move programs to their final expected locations. Although this is not "
"necessary in this temporary environment, we must do so because some programs"
" hardcode executable locations:"
msgstr ""
"Mova aplicativos para os locais finais deles esperados. Apesar de isso não "
"ser necessário neste ambiente temporário, nós precisamos fazer isso, pois "
"alguns aplicativos codificam rigidamente locais de executável:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter06/coreutils.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">mv -v $LFS/usr/bin/chroot              $LFS/usr/sbin\n"
"mkdir -pv $LFS/usr/share/man/man8\n"
"mv -v $LFS/usr/share/man/man1/chroot.1 $LFS/usr/share/man/man8/chroot.8\n"
"sed -i 's/\"1\"/\"8\"/'                    $LFS/usr/share/man/man8/chroot.8</userinput>"
msgstr ""
"<userinput remap=\"install\">mv -v $LFS/usr/bin/chroot              $LFS/usr/sbin\n"
"mkdir -pv $LFS/usr/share/man/man8\n"
"mv -v $LFS/usr/share/man/man1/chroot.1 $LFS/usr/share/man/man8/chroot.8\n"
"sed -i 's/\"1\"/\"8\"/'                    $LFS/usr/share/man/man8/chroot.8</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter06/coreutils.xml:97
#, xml-text
msgid ""
"Details on this package are located in <xref linkend=\"contents-coreutils\" "
"role=\".\"/>"
msgstr ""
"Detalhes acerca deste pacote estão localizados na <xref linkend=\"contents-"
"coreutils\" role=\".\"/>"

