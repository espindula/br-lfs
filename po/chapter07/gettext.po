#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter07/gettext.xml:44
#, xml-text
msgid "Installation of Gettext"
msgstr "Instalação do Gettext"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/gettext.xml:46
#, xml-text
msgid ""
"For our temporary set of tools, we only need to install three programs from "
"Gettext."
msgstr ""
"Para nosso conjunto temporário de ferramentas, nós precisamos somente "
"instalar três aplicativos originários do Gettext."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/gettext.xml:49
#, xml-text
msgid "Prepare Gettext for compilation:"
msgstr "Prepare o Gettext para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter07/gettext.xml:51
#, no-wrap, xml-text
msgid "<userinput remap=\"configure\">./configure --disable-shared</userinput>"
msgstr "<userinput remap=\"configure\">./configure --disable-shared</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter07/gettext.xml:54
#, xml-text
msgid "The meaning of the configure option:"
msgstr "O significado da opção de configure:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter07/gettext.xml:57
#, xml-text
msgid "<parameter>--disable-shared</parameter>"
msgstr "<parameter>--disable-shared</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter07/gettext.xml:59
#, xml-text
msgid ""
"We do not need to install any of the shared Gettext libraries at this time, "
"therefore there is no need to build them."
msgstr ""
"Nós não precisamos instalar quaisquer das bibliotecas compartilhadas do "
"Gettext nesta ocasião, assim não existe necessidade de construí-las."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/gettext.xml:66
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter07/gettext.xml:68
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/gettext.xml:70
#, xml-text
msgid ""
"Install the <command>msgfmt</command>, <command>msgmerge</command>, and "
"<command>xgettext</command> programs:"
msgstr ""
"Instale os aplicativos <command>msgfmt</command>, "
"<command>msgmerge</command> e <command>xgettext</command>:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter07/gettext.xml:73
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">cp -v gettext-"
"tools/src/{msgfmt,msgmerge,xgettext} /usr/bin</userinput>"
msgstr ""
"<userinput remap=\"install\">cp -v gettext-"
"tools/src/{msgfmt,msgmerge,xgettext} /usr/bin</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/gettext.xml:80
#, xml-text
msgid ""
"Details on this package are located in <xref linkend=\"contents-gettext\" "
"role=\".\"/>"
msgstr ""
"Detalhes acerca deste pacote estão localizados na <xref linkend=\"contents-"
"gettext\" role=\".\"/>"

