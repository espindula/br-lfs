#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/mpdecimal.xml:45
#, xml-text
msgid "Prepare mpdecimal for compilation:"
msgstr "Prepare mpdecimal para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter07/mpdecimal.xml:47
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/mpdecimal-&mpdecimal-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/mpdecimal-&mpdecimal-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/mpdecimal.xml:51
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter07/mpdecimal.xml:53
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/mpdecimal.xml:55
#, xml-text
msgid "Install the package:"
