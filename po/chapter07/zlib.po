#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter07/zlib.xml:43
#, xml-text
msgid "Installation of Zlib"
msgstr "Instalação do Zlib"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/zlib.xml:45
#, xml-text
msgid "Prepare Zlib for compilation:"
msgstr "Prepare Zlib para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter07/zlib.xml:47
#, no-wrap, xml-text
msgid "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"
msgstr "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/zlib.xml:49
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter07/zlib.xml:51
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/zlib.xml:53
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter07/zlib.xml:55
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter07/zlib.xml:57
#, xml-text
msgid "Remove a useless static library:"
msgstr "Remova uma biblioteca estática inútil:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter07/zlib.xml:59
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">rm -fv /usr/lib/libz.a</userinput>"
msgstr "<userinput remap=\"install\">rm -fv /usr/lib/libz.a</userinput>"

