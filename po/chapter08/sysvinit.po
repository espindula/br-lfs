#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/sysvinit.xml:126
#, xml-text
msgid "<command>halt</command>"
msgstr "<command>halt</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/sysvinit.xml:128
#, xml-text
msgid ""
"Normally invokes <command>shutdown</command> with the "
"<parameter>-h</parameter> option, but when already in run-level 0, it tells "
"the kernel to halt the system; it notes in the file "
"<filename>/var/log/wtmp</filename> that the system is going down"
msgstr ""
"Normalmente invoca <command>shutdown</command> com a opção "
"<parameter>-h</parameter>, porém quando já em nível de execução 0, diz ao "
"núcleo para parar o sistema; ele anota no arquivo "
"<filename>/var/log/wtmp</filename> que o sistema está sendo desligado"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/sysvinit.xml:134
#, xml-text
msgid "halt"
msgstr "parar"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/sysvinit.xml:140
#, xml-text
msgid "<command>init</command>"
msgstr "<command>init</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/sysvinit.xml:142
#, xml-text
msgid ""
"The first process to be started when the kernel has initialized the "
"hardware; it takes over the boot process and starts all the processes "
"specified in its configuration file"
msgstr ""
"O primeiro processo a ser iniciado quando o núcleo tenha inicializado o "
"hardware; ele assume o processo de inicialização e inicia todos os processos"
" especificados no arquivo de configuração dele"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/sysvinit.xml:146
#, xml-text
msgid "init"
msgstr "init"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/sysvinit.xml:152
#, xml-text
msgid "<command>killall5</command>"
msgstr "<command>killall5</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/sysvinit.xml:154
#, xml-text
msgid ""
"Sends a signal to all processes, except the processes in its own session; it"
" will not kill its parent shell"
msgstr ""
"Envia um sinal para todos os processos, exceto os processos na própria "
"sessão dele; ele não matará o shell ancestral dele"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/sysvinit.xml:157
#, xml-text
msgid "killall5"
msgstr "killall5"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/sysvinit.xml:163
#, xml-text
msgid "<command>poweroff</command>"
msgstr "<command>poweroff</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/sysvinit.xml:165
#, xml-text
msgid ""
"Tells the kernel to halt the system and switch off the computer (see "
"<command>halt</command>)"
msgstr ""
"Diz ao núcleo para parar o sistema e desligar o computador (veja-se "
"<command>halt</command>)"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/sysvinit.xml:168
#, xml-text
msgid "poweroff"
msgstr "poweroff"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/sysvinit.xml:174
#, xml-text
msgid "<command>reboot</command>"
msgstr "<command>reboot</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/sysvinit.xml:176
#, xml-text
msgid "Tells the kernel to reboot the system (see <command>halt</command>)"
msgstr ""
"Diz ao núcleo para reinicializar o sistema (veja-se <command>halt</command>)"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/sysvinit.xml:179
#, xml-text
msgid "reboot"
msgstr "reinicializar"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/sysvinit.xml:185
#, xml-text
msgid "<command>runlevel</command>"
msgstr "<command>runlevel</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/sysvinit.xml:187
#, xml-text
msgid ""
"Reports the previous and the current run-level, as noted in the last run-"
"level record in <filename>/run/utmp</filename>"
msgstr ""
"Informa o nível de execução anterior e o atual, conforme anotado no registro"
" mais recente de nível de execução em <filename>/run/utmp</filename>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/sysvinit.xml:190
#, xml-text
msgid "runlevel"
msgstr "runlevel"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/sysvinit.xml:196
#, xml-text
msgid "<command>shutdown</command>"
msgstr "<command>shutdown</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/sysvinit.xml:198
#, xml-text
msgid ""
"Brings the system down in a secure way, signaling all processes and "
"notifying all logged-in users"
msgstr ""
"Desliga o sistema de uma maneira segura, sinalizando todos os processos e "
"notificando todos(as) os(as) usuários(as) logados(as)"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/sysvinit.xml:201
#, xml-text
msgid "shutdown"
msgstr "shutdown"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/sysvinit.xml:207
#, xml-text
msgid "<command>telinit</command>"
msgstr "<command>telinit</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/sysvinit.xml:209
#, xml-text
msgid "Tells <command>init</command> which run-level to change to"
msgstr "Informa ao <command>init</command> para qual nível de execução mudar"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/sysvinit.xml:211
#, xml-text
msgid "telinit"
msgstr "telinit"
