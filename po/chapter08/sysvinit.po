#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/sysvinit.xml:26
#, xml-text
msgid ""
"The SysVinit package contains programs for controlling the startup, running,"
" and shutdown of the system."
msgstr ""
"O pacote SysVinit contém programas para controlar a inicialização, execução "
"e desligamento do sistema."

