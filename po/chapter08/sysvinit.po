#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/sysvinit.xml:42
#, xml-text
msgid "Installation of SysVinit"
msgstr "Instalação do SysVinit"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/sysvinit.xml:70
#, xml-text
msgid ""
"First, apply a patch that removes several programs installed by other "
"packages, clarifies a message, and fixes a compiler warning:"
msgstr ""
"Primeiro, aplique um remendo que remove vários aplicativos instalados por "
"outros pacotes, esclarece uma mensagem e corrige um aviso de compilador:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/sysvinit.xml:73
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../&sysvinit-consolidated-"
"patch;</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../&sysvinit-consolidated-"
"patch;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/sysvinit.xml:75
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/sysvinit.xml:77
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/sysvinit.xml:79
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/sysvinit.xml:81
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/sysvinit.xml:83
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/sysvinit.xml:88
#, xml-text
msgid "Contents of SysVinit"
msgstr "Conteúdo do SysVinit"

