#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/perl.xml:103
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/perl.xml:105
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/perl.xml:107
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/perl.xml:109
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">TEST_JOBS=$(nproc) make test_harness</userinput>"
msgstr ""
"<userinput remap=\"test\">TEST_JOBS=$(nproc) make test_harness</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/perl.xml:111
#, xml-text
msgid "Install the package and clean up:"
msgstr "Instale o pacote e limpe:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/perl.xml:113
#, no-wrap, xml-text
