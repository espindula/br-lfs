"<userinput remap=\"install\">make install\n"
"unset BUILD_ZLIB BUILD_BZIP2</userinput>"
msgstr ""
"<userinput remap=\"install\">make install\n"
"unset BUILD_ZLIB BUILD_BZIP2</userinput>"

