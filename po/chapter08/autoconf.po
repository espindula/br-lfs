#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/autoconf.xml:44
#, xml-text
msgid "Prepare Autoconf for compilation:"
msgstr "Prepare Autoconf para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/autoconf.xml:46
#, no-wrap, xml-text
msgid "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"
msgstr "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/autoconf.xml:48
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/autoconf.xml:50
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/autoconf.xml:52
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#.     <para>
#. The test suite is currently broken by bash-5 and libtool-2.4.3.
#.     To run the tests anyway, issue:</para>
#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/autoconf.xml:57
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check</userinput>"
msgstr "<userinput remap=\"test\">make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/autoconf.xml:59
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/autoconf.xml:61
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

