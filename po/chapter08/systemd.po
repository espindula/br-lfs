#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/systemd.xml:41
#, xml-text
msgid "Installation of systemd"
msgstr "Instalação do systemd"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/systemd.xml:50
#, xml-text
msgid ""
"Remove two unneeded groups, <systemitem "
"class=\"groupname\">render</systemitem> and <systemitem "
"class=\"groupname\">sgx</systemitem>, from the default udev rules:"
msgstr ""
"Remova dois grupos desnecessários, <systemitem "
"class=\"groupname\">render</systemitem> e <systemitem "
"class=\"groupname\">sgx</systemitem>, das regras padrão do \"udev\":"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/systemd.xml:55
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -e 's/GROUP=\"render\"/GROUP=\"video\"/' \\\n"
"    -e 's/GROUP=\"sgx\", //'               \\\n"
"    -i rules.d/50-udev-default.rules.in</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -e 's/GROUP=\"render\"/GROUP=\"video\"/' \\\n"
"    -e 's/GROUP=\"sgx\", //'               \\\n"
"    -i rules.d/50-udev-default.rules.in</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/systemd.xml:59
#, xml-text
msgid "Prepare systemd for compilation:"
msgstr "Prepare systemd para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/systemd.xml:61
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">mkdir -p build\n"
"cd       build\n"
"\n"
"meson setup ..                \\\n"
"      --prefix=/usr           \\\n"
"      --buildtype=release     \\\n"
"      -D default-dnssec=no    \\\n"
"      -D firstboot=false      \\\n"
"      -D install-tests=false  \\\n"
"      -D ldconfig=false       \\\n"
"      -D sysusers=false       \\\n"
"      -D rpmmacrosdir=no      \\\n"
"      -D homed=disabled       \\\n"
"      -D man=disabled         \\\n"
"      -D mode=release         \\\n"
"      -D pamconfdir=no        \\\n"
"      -D dev-kvm-mode=0660    \\\n"
"      -D nobody-group=nogroup \\\n"
"      -D sysupdate=disabled   \\\n"
"      -D ukify=disabled       \\\n"
"      -D docdir=/usr/share/doc/systemd-&systemd-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">mkdir -p build\n"
"cd       build\n"
"\n"
"meson setup ..                \\\n"
"      --prefix=/usr           \\\n"
"      --buildtype=release     \\\n"
"      -D default-dnssec=no    \\\n"
"      -D firstboot=false      \\\n"
"      -D install-tests=false  \\\n"
"      -D ldconfig=false       \\\n"
"      -D sysusers=false       \\\n"
"      -D rpmmacrosdir=no      \\\n"
"      -D homed=disabled       \\\n"
"      -D man=disabled         \\\n"
"      -D mode=release         \\\n"
"      -D pamconfdir=no        \\\n"
"      -D dev-kvm-mode=0660    \\\n"
"      -D nobody-group=nogroup \\\n"
"      -D sysupdate=disabled   \\\n"
"      -D ukify=disabled       \\\n"
"      -D docdir=/usr/share/doc/systemd-&systemd-version;</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/systemd.xml:84
#, xml-text
msgid "The meaning of the meson options:"
msgstr "O significado das opções do meson:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:87
#, xml-text
msgid "<parameter>--buildtype=release</parameter>"
msgstr "<parameter>--buildtype=release</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:89
#, xml-text
msgid ""
"This switch overrides the default buildtype (<quote>debug</quote>), which "
"produces unoptimized binaries."
msgstr ""
"Essa chave substitui o tipo de construção padrão (<quote>debug</quote>), que"
" produz binários não otimizados."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:96
#, xml-text
msgid "<parameter>-D default-dnssec=no</parameter>"
msgstr "<parameter>-D default-dnssec=no</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:98
#, xml-text
msgid "This switch turns off the experimental DNSSEC support."
msgstr "Essa chave desliga o suporte experimental a DNSSEC."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:103
#, xml-text
msgid "<parameter>-D firstboot=false</parameter>"
msgstr "<parameter>-D firstboot=false</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:105
#, xml-text
msgid ""
"This switch prevents installation of systemd services responsible for "
"setting up the system for the first time. These are not useful in LFS, "
"because everything is done manually."
msgstr ""
"Essa chave impede a instalação de serviços do systemd responsáveis por "
"configurar o sistema pela primeira vez. Eles não são úteis no LFS, pois tudo"
" é feito manualmente."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:113
#, xml-text
msgid "<parameter>-D install-tests=false</parameter>"
msgstr "<parameter>-D install-tests=false</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:115
#, xml-text
msgid "This switch prevents installation of the compiled tests."
msgstr "Essa chave impede a instalação dos testes compilados."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:120
#, xml-text
msgid "<parameter>-D ldconfig=false</parameter>"
msgstr "<parameter>-D ldconfig=false</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:122
#, xml-text
msgid ""
"This switch prevents installation of a systemd unit that runs "
"<command>ldconfig</command> at boot; this is not useful for source "
"distributions such as LFS, and makes the boot time longer. Remove this "
"option to enable running <command>ldconfig</command> at boot."
msgstr ""
"Essa chave impede a instalação de uma unidade do systemd que executa "
"<command>ldconfig</command> ao inicializar; isso não é útil para "
"distribuições de fonte, tais como o LFS, e torna o tempo de inicialização "
"mais longo. Remova essa opção para habilitar a execução de "
"<command>ldconfig</command> ao inicializar."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:130
#, xml-text
msgid "<parameter>-D sysusers=false</parameter>"
msgstr "<parameter>-D sysusers=false</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:132
#, xml-text
msgid ""
"This switch prevents installation of systemd services responsible for "
"setting up the <filename>/etc/group</filename> and "
"<filename>/etc/passwd</filename> files. Both files were created in the "
"previous chapter. This daemon is not useful on an LFS system since user "
"accounts are manually created."
msgstr ""
"Essa chave impede a instalação de serviços do systemd responsáveis por "
"configurar os arquivos <filename>/etc/group</filename> e "
"<filename>/etc/passwd</filename>. Ambos os arquivos foram criados no "
"capítulo anterior. Esse processo de segundo plano não é útil em um sistema "
"LFS dado que contas de usante são criadas manualmente."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:142
#, xml-text
msgid "<parameter>-D rpmmacrosdir=no</parameter>"
msgstr "<parameter>-D rpmmacrosdir=no</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:144
#, xml-text
msgid ""
"This switch disables installation of RPM Macros for use with systemd, "
"because LFS does not support RPM."
msgstr ""
"Essa chave desabilita a instalação das Macros RPM para uso com o systemd, "
"pois o LFS não suporta RPM."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:150
#, xml-text
msgid "<parameter>-D homed=disabled</parameter>"
msgstr "<parameter>-D homed=disabled</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:152
#, xml-text
msgid ""
"Remove a daemon which has dependencies that do not fit within the scope of "
"LFS."
msgstr ""
"Remova um processo de segundo plano que tem dependências que não se encaixam"
" no escopo do LFS."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:158
#, xml-text
msgid "<parameter>-D man=disabled</parameter>"
msgstr "<parameter>-D man=disabled</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:160
#, xml-text
msgid ""
"Prevent the generation of man pages to avoid extra dependencies.  We will "
"install pre-generated man pages for systemd from a tarball."
msgstr ""
"Impeça a geração de páginas de manual para evitar dependências extras. Nós "
"instalaremos páginas de manual pré-geradas para o systemd a partir de um "
"tarball."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:167
#, xml-text
msgid "<parameter>-D mode=release</parameter>"
msgstr "<parameter>-D mode=release</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:169
#, xml-text
msgid "Disable some features considered experimental by upstream."
msgstr ""
"Desabilite alguns recursos considerados experimentais pelo(a) "
"desenvolvedor(a)."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:175
#, xml-text
msgid "<parameter>-D pamconfdir=no</parameter>"
msgstr "<parameter>-D pamconfdir=no</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:177
#, xml-text
msgid ""
"Prevent the installation of a PAM configuration file not functional on LFS."
msgstr ""
"Evita a instalação de um arquivo de configuração do PAM não funcional no "
"LFS."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:183
#, xml-text
msgid "<parameter>-D dev-kvm-mode=0660</parameter>"
msgstr "<parameter>-D dev-kvm-mode=0660</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:185
#, xml-text
msgid ""
"The default udev rule would allow all users to access <filename "
"class='devicefile'>/dev/kvm</filename>.  The editors consider it dangerous."
"  This option overrides it."
msgstr ""
"A regra padrão do udev permitiria que todos(as) usantes acessassem <filename"
" class='devicefile'>/dev/kvm</filename>. Os(As) editores(as) a consideram "
"perigosa. Essa opção a substitui."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:192
#, xml-text
msgid "<parameter>-D nobody-group=nogroup</parameter>"
msgstr "<parameter>-D nobody-group=nogroup</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:194
#, xml-text
msgid ""
"Tell the package the group name with GID 65534 is <systemitem "
"class='groupname'>nogroup</systemitem>."
msgstr ""
"Informe ao pacote que o nome do grupo com GID 65534 é <systemitem "
"class='groupname'>nogroup</systemitem>."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:200
#, xml-text
msgid "<parameter>-D sysupdate=disabled</parameter>"
msgstr "<parameter>-D sysupdate=disabled</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:202
#, xml-text
msgid ""
"Do not install the <command>systemd-sysupdate</command> tool.  It's designed"
" for automatically upgrading binary distros, so it's useless for a basic "
"Linux system built from source.  And it will report errors on boot if it's "
"enabled but not properly configured."
msgstr ""
"Não instale a ferramenta &quot;<command>systemd-sysupdate</command>&quot;. "
"Ela foi projetada para atualizar automaticamente distribuições binárias, de "
"forma que é inútil para um sistema básico do Linux construído a partir do "
"fonte. E informará erros na inicialização se estiver habilitada, mas não "
"configurada corretamente."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/systemd.xml:211
#, xml-text
msgid "<parameter>-D ukify=disabled</parameter>"
msgstr "<parameter>-D ukify=disabled</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/systemd.xml:213
#, xml-text
msgid ""
"Do not install the <command>systemd-ukify</command> script.  At runtime this"
" script requires the <application>pefile</application> Python module that "
"neither LFS nor BLFS provides."
msgstr ""
"Não instale o conjunto de comandos sequenciais &quot;<command>systemd-"
"ukify</command>&quot;. Em tempo de execução, esse conjunto de comandos "
"sequenciais exige o módulo do &quot;Python&quot; "
"&quot;<application>pefile</application>&quot; que nem o LFS nem o BLFS "
"fornecem."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/systemd.xml:222
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/systemd.xml:224
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">ninja</userinput>"
msgstr "<userinput remap=\"make\">ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/systemd.xml:226
#, xml-text
msgid ""
"One test creates a mount point in <filename "
"class='directory'>/tmp</filename> that we cannot clean up so easily after "
"running the test suite, and some tests need a basic <filename>/etc/os-"
"release</filename> file.  To test the results, create this file and run the "
"test suite in a separate mount namespace (so the mount point is only visible"
" for the test suite and it gets cleaned up automatically after the test "
"suite finishes):"
msgstr ""
"Um teste cria um ponto de montagem no <filename "
"class='directory'>/tmp</filename> que nós não conseguimos eliminar tão "
"facilmente depois de executar a suíte de teste, e alguns testes precisam de "
"um arquivo <filename>/etc/os-release</filename> básico. Para testar os "
"resultados, crie esse arquivo e execute a suíte de teste em um espaço "
"separado de nomes de montagem (para que o ponto de montagem fique visível "
"somente para a suíte de teste e seja eliminado automaticamente depois do "
"término da suíte de teste):"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/systemd.xml:234
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"test\">echo 'NAME=\"Linux From Scratch\"' &gt; /etc/os-release\n"
"unshare -m ninja test</userinput>"
msgstr ""
"<userinput remap=\"test\">echo 'NAME=\"Linux From Scratch\"' &gt; /etc/os-release\n"
"unshare -m ninja test</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/systemd.xml:240
#, xml-text
msgid ""
"Three tests are known to fail in the LFS chroot environment but pass in a "
"full installation: <literal>core - systemd:test-namespace</literal>, "
"<literal>test - systemd:test-chase</literal>, and <literal>tmpfiles - "
"systemd:test-systemd-tmpfiles</literal>.  Some additional tests may fail "
"because they depend on various kernel configuration options. The test named "
"<literal>test - systemd:test-copy</literal> may time out due to I/O "
"congestion with a large parallel job number, but will pass if running alone "
"with <command>meson test test-copy</command>."
msgstr ""
"Três testes são conhecidos por falharem no ambiente chroot do LFS, mas "
"passam em uma instalação completa: <literal>core - systemd:test-"
"namespace</literal>, <literal>test - systemd:test-chase</literal> e "
"<literal>tmpfiles - systemd:test-systemd-tmpfiles</literal>. Alguns testes "
"adicionais possivelmente falhem porque eles dependem de várias opções de "
"configuração do núcleo. O teste nominado <literal>test - systemd:test-"
"copy</literal> possivelmente exceda o tempo limite devido à congestão de E/S"
" com um grande número de tarefas paralelas, mas passará se executado "
"isoladamente com <command>meson test test-copy</command>."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/systemd.xml:253
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/systemd.xml:255
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">ninja install</userinput>"
msgstr "<userinput remap=\"install\">ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/systemd.xml:257
#, xml-text
msgid "Install the man pages:"
msgstr "Instale as páginas de manual:"

#.  Please make sure systemd man pages tarball has a common leading
#.          component in the path.
#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/systemd.xml:261
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">tar -xf ../../systemd-man-pages-&systemd-man-version;.tar.xz \\\n"
"    --no-same-owner --strip-components=1     \\\n"
"    -C /usr/share/man</userinput>"
msgstr ""
"<userinput remap=\"install\">tar -xf ../../systemd-man-pages-&systemd-man-version;.tar.xz \\\n"
"    --no-same-owner --strip-components=1     \\\n"
"    -C /usr/share/man</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/systemd.xml:265
#, xml-text
msgid ""
"Create the <filename>/etc/machine-id</filename> file needed by "
"<command>systemd-journald</command>:"
msgstr ""
"Crie o arquivo <filename>/etc/machine-id</filename> necessitado pelo "
"<command>systemd-journald</command>:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/systemd.xml:268
#, no-wrap, xml-text
msgid "<userinput remap=\"adjust\">systemd-machine-id-setup</userinput>"
msgstr "<userinput remap=\"adjust\">systemd-machine-id-setup</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/systemd.xml:270
#, xml-text
msgid "Set up the basic target structure:"
msgstr "Configure a estrutura básica alvo:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/systemd.xml:272
#, no-wrap, xml-text
msgid "<userinput remap=\"adjust\">systemctl preset-all</userinput>"
msgstr "<userinput remap=\"adjust\">systemctl preset-all</userinput>"

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/systemd.xml:286
#, xml-text
msgid "Contents of systemd"
msgstr "Conteúdo do systemd"

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: lfs-en/chapter08/systemd.xml:289
#, xml-text
msgid "Installed programs"
msgstr "Programas instalados"

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: lfs-en/chapter08/systemd.xml:290
#, xml-text
msgid "Installed libraries"
msgstr "Bibliotecas instaladas"

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: lfs-en/chapter08/systemd.xml:291
#, xml-text
msgid "Installed directories"
msgstr "Diretórios instalados"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/systemd.xml:294
#, xml-text
msgid ""
"bootctl, busctl, coredumpctl, halt (symlink to systemctl), hostnamectl, "
"init, journalctl, kernel-install, localectl, loginctl, machinectl, mount.ddi"
" (symlink to systemd-dissect), networkctl, oomctl, portablectl, poweroff "
"(symlink to systemctl), reboot (symlink to systemctl), resolvconf (symlink "
"to resolvectl), resolvectl, run0 (symlink to systemd-run), runlevel (symlink"
" to systemctl), shutdown (symlink to systemctl), systemctl, systemd-ac-"
"power, systemd-analyze, systemd-ask-password, systemd-cat, systemd-cgls, "
