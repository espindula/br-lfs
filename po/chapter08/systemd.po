#~ "systemd:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap='pre'>sed -e '/return FLAGS_SET.*AUTHENTICATED/s/(t/(dt/' \\\n"
#~ "    -i src/resolve/resolved-dns-transaction.c</userinput>"
