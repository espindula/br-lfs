#~ msgid "Next, fix compatibility with API headers from linux-6.9 and later:"
#~ msgstr ""
#~ "A seguir, corrija compatibilidade com cabeçalhos de API provenientes do "
#~ "linux-6.9 e posteriores:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed -i '/DEVMEM_MAGIC 0/{n;n;a \\\n"
#~ "/* cb12fd8e0dabb9a1c8aef55a6a41e2c255fcdf4b (6.8) */ \\\n"
#~ "#ifndef PID_FS_MAGIC \\\n"
#~ "#define PID_FS_MAGIC 0x50494446 \\\n"
#~ "#endif\n"
#~ "}' src/basic/missing_magic.h\n"
#~ "\n"
#~ "sed -i '/OVERLAYFS_SUPER_MAGIC/a \\\n"
#~ "pidfs,           {PID_FS_MAGIC}' src/basic/filesystems-gperf.gperf</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">sed -i '/DEVMEM_MAGIC 0/{n;n;a \\\n"
#~ "/* cb12fd8e0dabb9a1c8aef55a6a41e2c255fcdf4b (6.8) */ \\\n"
#~ "#ifndef PID_FS_MAGIC \\\n"
#~ "#define PID_FS_MAGIC 0x50494446 \\\n"
#~ "#endif\n"
#~ "}' src/basic/missing_magic.h\n"
#~ "\n"
#~ "sed -i '/OVERLAYFS_SUPER_MAGIC/a \\\n"
#~ "pidfs,           {PID_FS_MAGIC}' src/basic/filesystems-gperf.gperf</userinput>"

#, xml-text
#~ msgid ""
#~ "Now fix a security vulnerability in the DNSSEC verification of "
#~ "<command>systemd-resolved</command> and a bug breaking running "
#~ "<command>systemd-analyze verify</command> on an instantiated systemd unit:"
#~ msgstr ""
#~ "Agora corrija uma vulnerabilidade de segurança na verificação DNSSEC de "
#~ "<command>systemd-resolved</command> e um defeito que quebra "
#~ "<command>systemd-analyze verify</command> em uma unidade instanciada do "
#~ "systemd:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap='pre'>patch -Np1 -i ../&systemd-upstream-patch;</userinput>"
#~ msgstr ""
#~ "<userinput remap='pre'>patch -Np1 -i ../&systemd-upstream-patch;</userinput>"

#, no-wrap, xml-text
