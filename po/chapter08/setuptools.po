#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/setuptools.xml:41
#, xml-text
msgid "Installation of Setuptools"
msgstr "Instalação do <quote>Setuptools</quote>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/setuptools.xml:43
#, xml-text
msgid "Build the package:"
msgstr "Construa o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/setuptools.xml:45
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir --no-build-"
"isolation --no-deps $PWD</userinput>"
msgstr ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir --no-build-"
"isolation --no-deps $PWD</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/setuptools.xml:47
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/setuptools.xml:49
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"setuptools</userinput>"
msgstr ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"setuptools</userinput>"

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/setuptools.xml:53
#, xml-text
msgid "Contents of Setuptools"
msgstr "Conteúdo do <quote>Setuptools</quote>"

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: lfs-en/chapter08/setuptools.xml:56
#, xml-text
msgid "Installed directory"
msgstr "Diretório instalado"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/setuptools.xml:60
#, xml-text
msgid ""
"/usr/lib/python&python-minor;/site-packages/_distutils_hack, "
"/usr/lib/python&python-minor;/site-packages/pkg_resources, "
"/usr/lib/python&python-minor;/site-packages/setuptools, and "
"/usr/lib/python&python-minor;/site-packages/setuptools-&setuptools-"
"version;.dist-info"
msgstr ""
"/usr/lib/python&python-minor;/site-packages/_distutils_hack, "
"/usr/lib/python&python-minor;/site-packages/pkg_resources, "
"/usr/lib/python&python-minor;/site-packages/setuptools e "
"/usr/lib/python&python-minor;/site-packages/setuptools-&setuptools-"
"version;.dist-info"
