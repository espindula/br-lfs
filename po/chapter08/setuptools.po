#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/setuptools.xml:26
#, xml-text
msgid ""
"Setuptools is a tool used to download, build, install, upgrade, and "
"uninstall Python packages."
msgstr ""
"&quot;Setuptools&quot; é uma ferramenta usada para baixar, construir, "
"instalar, atualizar e desinstalar pacotes &quot;Python&quot;."

