#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/pcre.xml:42
#, xml-text
msgid "Installation of Pcre2"
msgstr "Instalação do Pcre2"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pcre.xml:44
#, xml-text
msgid "Prepare pcre2 for compilation:"
msgstr "Prepare pcre2 para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pcre.xml:46
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr                       \\\n"
"            --docdir=/usr/share/doc/pcre2-&pcre2-version; \\\n"
"            --enable-unicode                    \\\n"
"            --enable-jit                        \\\n"
"            --enable-pcre2-16                   \\\n"
"            --enable-pcre2-32                   \\\n"
"            --enable-pcre2grep-libz             \\\n"
"            --enable-pcre2grep-libbz2           \\\n"
"            --enable-pcre2test-libreadline      \\\n"
"            --disable-static</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/"
"usr                       \\\n"
"            --docdir=/usr/share/doc/pcre2-&pcre2-version; \\\n"
"            --enable-unicode                    \\\n"
"            --enable-jit                        \\\n"
"            --enable-pcre2-16                   \\\n"
"            --enable-pcre2-32                   \\\n"
"            --enable-pcre2grep-libz             \\\n"
"            --enable-pcre2grep-libbz2           \\\n"
"            --enable-pcre2test-libreadline      \\\n"
"            --disable-static</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/pcre.xml:58
#, xml-text
msgid "The meaning of the new configure options:"
msgstr "O significado das novas opções de configuração:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/pcre.xml:61
#, xml-text
msgid "<parameter>--enable-unicode</parameter>"
msgstr "<parameter>--enable-unicode</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/pcre.xml:64
#, xml-text
msgid ""
"This option enables Unicode support and includes the functions for handling "
"UTF-8/16/32 character strings in the library."
msgstr ""
"Essa opção habilita o suporte Unicode e inclui as funções para manusear "
"sequências de caracteres UTF-8/16/32 na biblioteca."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/pcre.xml:71
#, xml-text
msgid "<parameter>--enable-jit</parameter>"
msgstr "<parameter>--enable-jit</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/pcre.xml:74
#, xml-text
msgid ""
"This option enables Just-in-time compiling, which can greatly speed up "
"pattern matching."
msgstr ""
"Essa opção habilita compilação just-in-time, o que pode acelerar bastante a "
"correspondência de padrões."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/pcre.xml:81
#, xml-text
msgid "<parameter>--enable-pcre2-16</parameter>"
msgstr "<parameter>--enable-pcre2-16</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/pcre.xml:84
#, xml-text
msgid "This option enables 16 bit character support."
msgstr "Essa opção habilita suporte a caracteres de 16 bits."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/pcre.xml:90
#, xml-text
msgid "<parameter>--enable-pcre2-32</parameter>"
msgstr "<parameter>--enable-pcre2-32</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/pcre.xml:93
#, xml-text
msgid "This option enables 32 bit character support."
msgstr "Essa opção habilita suporte a caracteres de 32 bits."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/pcre.xml:99
#, xml-text
msgid "<parameter>--enable-pcre2grep-libz</parameter>"
msgstr "<parameter>--enable-pcre2grep-libz</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/pcre.xml:102
#, xml-text
msgid ""
"This option adds support for reading .gz compressed files to pcre2grep."
msgstr ""
"Essa opção adiciona suporte para leitura de arquivos comprimidos .gz no "
"pcre2grep."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/pcre.xml:108
#, xml-text
msgid "<parameter>--enable-pcre2grep-libbz2</parameter>"
msgstr "<parameter>--enable-pcre2grep-libbz2</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/pcre.xml:111
#, xml-text
msgid ""
"This option adds support for reading .bz2 compressed files to pcre2grep."
msgstr ""
"Essa opção adiciona suporte para leitura de arquivos comprimidos .bz2 ao "
"pcre2grep."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/pcre.xml:117
#, xml-text
msgid "<parameter>--enable-pcre2test-libreadline</parameter>"
msgstr "<parameter>--enable-pcre2test-libreadline</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/pcre.xml:120
#, xml-text
msgid ""
"This option adds line editing and history features to the pcre2test program."
msgstr ""
"Essa opção adiciona recursos de edição de linha e de histórico ao programa "
"pcre2test."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pcre.xml:127
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pcre.xml:129
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pcre.xml:131
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pcre.xml:133
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check</userinput>"
msgstr "<userinput remap=\"test\">make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pcre.xml:135
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pcre.xml:137
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

