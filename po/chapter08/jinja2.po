#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/jinja2.xml:41
#, xml-text
msgid "Installation of Jinja2"
msgstr "Instalação do Jinja2"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/jinja2.xml:43
#, xml-text
msgid "Build the package:"
msgstr "Construa o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/jinja2.xml:45
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir --no-build-"
"isolation --no-deps $PWD</userinput>"
msgstr ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir --no-build-"
"isolation --no-deps $PWD</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/jinja2.xml:47
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/jinja2.xml:49
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"Jinja2</userinput>"
msgstr ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"Jinja2</userinput>"

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/jinja2.xml:54
#, xml-text
msgid "Contents of Jinja2"
msgstr "Conteúdo do Jinja2"

