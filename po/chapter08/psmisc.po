#: lfs-en/chapter08/psmisc.xml:79
#, xml-text
msgid "<command>fuser</command>"
msgstr "<command>fuser</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/psmisc.xml:81
#, xml-text
msgid ""
"Reports the Process IDs (PIDs) of processes that use the given files or file"
" systems"
msgstr ""
"Informa os IDs de Processos (PIDs) de processos que usam os arquivos ou "
"sistemas de arquivos dados"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/psmisc.xml:84
#, xml-text
msgid "fuser"
msgstr "fuser"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/psmisc.xml:90
#, xml-text
msgid "<command>killall</command>"
msgstr "<command>killall</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/psmisc.xml:92
#, xml-text
msgid ""
"Kills processes by name; it sends a signal to all processes running any of "
"the given commands"
msgstr ""
"Mata processos pelo nome; envia um sinal para todos os processos executando "
"quaisquer dos comandos dados"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/psmisc.xml:95
#, xml-text
msgid "killall"
msgstr "killall"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/psmisc.xml:101
#, xml-text
msgid "<command>peekfd</command>"
msgstr "<command>peekfd</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/psmisc.xml:103
#, xml-text
msgid "Peek at file descriptors of a running process, given its PID"
msgstr ""
"Dê uma olhada nos descritores de arquivo de um processo em execução, dado "
"seu PID"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/psmisc.xml:106
#, xml-text
msgid "peekfd"
msgstr "peekfd"

