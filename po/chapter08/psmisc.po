#, xml-text
msgid "<command>prtstat</command>"
msgstr "<command>prtstat</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/psmisc.xml:114
#, xml-text
msgid "Prints information about a process"
msgstr "Imprime informação a respeito de um processo"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/psmisc.xml:116
#, xml-text
