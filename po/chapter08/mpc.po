#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/mpc.xml:43
#, xml-text
msgid "Installation of MPC"
msgstr "Instalação do MPC"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/mpc.xml:45
#, xml-text
msgid "Prepare MPC for compilation:"
msgstr "Prepare MPC para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/mpc.xml:47
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/mpc-&mpc-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/mpc-&mpc-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/mpc.xml:51
#, xml-text
msgid "Compile the package and generate the HTML documentation:"
msgstr "Compile o pacote e gere a documentação HTML:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/mpc.xml:53
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"make\">make\n"
"make html</userinput>"
msgstr ""
"<userinput remap=\"make\">make\n"
"make html</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/mpc.xml:56
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/mpc.xml:58
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check</userinput>"
msgstr "<userinput remap=\"test\">make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/mpc.xml:60
#, xml-text
msgid "Install the package and its documentation:"
msgstr "Instale o pacote e a documentação dele:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/mpc.xml:62
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">make install\n"
"make install-html</userinput>"
msgstr ""
"<userinput remap=\"install\">make install\n"
"make install-html</userinput>"

