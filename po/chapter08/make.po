#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/make.xml:42
#, xml-text
msgid "Installation of Make"
msgstr "Instalação do Make"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/make.xml:44
#, xml-text
msgid "Prepare Make for compilation:"
msgstr "Prepare o Make para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/make.xml:46
#, no-wrap, xml-text
msgid "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"
msgstr "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/make.xml:48
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/make.xml:50
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/make.xml:54
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/make.xml:56
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"test\">chown -R tester .\n"
"su tester -c \"PATH=$PATH make check\"</userinput>"
msgstr ""
"<userinput remap=\"test\">chown -R tester .\n"
"su tester -c \"PATH=$PATH make check\"</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/make.xml:59
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/make.xml:61
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

