#, xml-text
msgid "Pkgconf-&pkgconf-version;"
msgstr "Pkgconf-&pkgconf-version;"

#. type: Content of: <sect1><indexterm><primary>
#: lfs-en/chapter08/pkgconf.xml:20
#, xml-text
msgid "Pkgconf"
msgstr "Pkgconf"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:26
#, xml-text
msgid ""
"The pkgconf package is a successor to pkg-config and contains a tool for "
"passing the include path and/or library paths to build tools during the "
"configure and make phases of package installations."
msgstr ""
"O pacote pkgconf é um sucessor do pkg-config e contém uma ferramenta para "
"passar o caminho \"include\" e(ou) caminhos de biblioteca para construir "
"ferramentas durante as fases \"configure\" e \"make\" de instalações de "
"pacotes."

