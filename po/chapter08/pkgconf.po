#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/pkgconf.xml:45
#, xml-text
msgid "Installation of Pkgconf"
msgstr "Instalação do Pkgconf"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:47
#, xml-text
msgid "First, work around a circular dependency on meson:"
msgstr "Primeiro, contorne uma dependência circular do meson:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:49
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">tar -xf ../meson-&meson-version;.tar.gz</userinput>"
msgstr ""
"<userinput remap=\"pre\">tar -xf ../meson-&meson-version;.tar.gz</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:51
#, xml-text
msgid "Prepare Pkgconf for compilation:"
msgstr "Prepare Pkgconf para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:53
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">mkdir build\n"
"cd    build\n"
"\n"
"python3 ../meson-&meson-version;/meson.py setup --prefix=/usr --buildtype=release ..</userinput>"
msgstr ""
"<userinput remap=\"configure\">mkdir build\n"
"cd    build\n"
"\n"
"python3 ../meson-&meson-version;/meson.py setup --prefix=/usr --buildtype=release ..</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:58
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:60
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">ninja</userinput>"
msgstr "<userinput remap=\"make\">ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:62
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:64
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">ninja test</userinput>"
msgstr "<userinput remap=\"test\">ninja test</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:66
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:68
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">ninja install\n"
"mv /usr/share/doc/pkgconf{,-&pkgconf-version;}</userinput>"
msgstr ""
"<userinput remap=\"install\">ninja install\n"
"mv /usr/share/doc/pkgconf{,-&pkgconf-version;}</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:71
#, xml-text
msgid ""
"To maintain compatibility with the original Pkg-config create two symlinks:"
msgstr ""
"Para manter a compatibilidade com o Pkg-config original, crie dois links "
"simbólicos:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:74
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">ln -sv pkgconf   /usr/bin/pkg-config\n"
"ln -sv pkgconf.1 /usr/share/man/man1/pkg-config.1</userinput>"
msgstr ""
"<userinput remap=\"install\">ln -sv pkgconf   /usr/bin/pkg-config\n"
"ln -sv pkgconf.1 /usr/share/man/man1/pkg-config.1</userinput>"

