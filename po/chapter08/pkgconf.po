#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/pkgconf.xml:45
#, xml-text
msgid "Installation of Pkgconf"
msgstr "Instalação do Pkgconf"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:47
#, xml-text
msgid "Prepare Pkgconf for compilation:"
msgstr "Prepare Pkgconf para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:49
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/pkgconf-&pkgconf-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/pkgconf-&pkgconf-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:53
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:55
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:57
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:59
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/pkgconf.xml:61
#, xml-text
msgid ""
"To maintain compatibility with the original Pkg-config create two symlinks:"
msgstr ""
"Para manter a compatibilidade com o Pkg-config original, crie dois links "
"simbólicos:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/pkgconf.xml:64
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">ln -sv pkgconf   /usr/bin/pkg-config\n"
"ln -sv pkgconf.1 /usr/share/man/man1/pkg-config.1</userinput>"
msgstr ""
"<userinput remap=\"install\">ln -sv pkgconf   /usr/bin/pkg-config\n"
"ln -sv pkgconf.1 /usr/share/man/man1/pkg-config.1</userinput>"

