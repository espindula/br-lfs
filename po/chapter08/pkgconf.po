#, xml-text
#~ msgid "Fix a regression in pkgconf-2.1.0 breaking BLFS packages:"
#~ msgstr ""
#~ "Corrija uma regressão no &quot;pkgconf-2.1.0&quot; quebrando pacotes do "
#~ "BLFS:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed -i 's/str\\(cmp.*package\\)/strn\\1, "
#~ "strlen(pkg-&gt;why)/' cli/main.c</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">sed -i 's/str\\(cmp.*package\\)/strn\\1, "
#~ "strlen(pkg-&gt;why)/' cli/main.c</userinput>"

#, xml-text
#~ msgid ""
#~ "Pkgconf-2.0.0 explicitly errors when attempting to run "
#~ "<option>--modversion</option> with multiple arguments, even if these "
#~ "arguments are constraints for the same package.  This breaks many packages "
#~ "in BLFS. Run this sed to reinstate the old output for pkgconf:"
#~ msgstr ""
#~ "O \"Pkgconf-2.0.0\" explicitamente apresenta erros ao tentar executar "
#~ "<option>--modversion</option> com vários argumentos, mesmo se esses "
#~ "argumentos sejam restrições para o mesmo pacote. Isso quebra muitos pacotes "
#~ "no BLFS. Execute este \"sed\" para restabelecer a saída gerada antiga para o"
#~ " \"pkgconf\":"
