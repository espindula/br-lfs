#. type: Content of: <sect1><indexterm><primary>
#: lfs-en/chapter08/libelf.xml:20
#, xml-text
msgid "Libelf"
msgstr "Libelf"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libelf.xml:26
#, xml-text
msgid ""
"Libelf is a library for handling ELF (Executable and Linkable Format)  "
"files."
msgstr ""
"Libelf é uma biblioteca para lidar com arquivos ELF (Executable and Linkable"
" Format)."

