#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/libelf.xml:42
#, xml-text
msgid "Installation of Libelf"
msgstr "Instalação do Libelf"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libelf.xml:44
#, xml-text
msgid ""
"Libelf is part of the elfutils-&elfutils-version; package. Use the "
"elfutils-&elfutils-version;.tar.bz2 file as the source tarball."
msgstr ""
"Libelf é parte do pacote elfutils-&elfutils-version;. Use o arquivo "
"elfutils-&elfutils-version;.tar.bz2 como o tarball fonte."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libelf.xml:47
#, xml-text
msgid "Prepare Libelf for compilation:"
msgstr "Prepare Libelf para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libelf.xml:49
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr        \\\n"
"            --disable-debuginfod \\\n"
"            --enable-libdebuginfod=dummy</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr        \\\n"
"            --disable-debuginfod \\\n"
"            --enable-libdebuginfod=dummy</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libelf.xml:53
#, xml-text
msgid "Compile only Libelf:"
msgstr "Compile somente o Libelf:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libelf.xml:55
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"make\">make -C lib\n"
"make -C libelf</userinput>"
msgstr ""
"<userinput remap=\"make\">make -C lib\n"
"make -C libelf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libelf.xml:58
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libelf.xml:60
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make -k check</userinput>"
msgstr "<userinput remap=\"test\">make -k check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libelf.xml:62
#, xml-text
msgid ""
"The above command builds the utilities that are part of the package as well "
"as the unit tests."
msgstr ""
"O comando acima constrói os utilitários que são parte do pacote, bem como os "
"testes de unidade."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libelf.xml:67
#, xml-text
msgid "Install only Libelf:"
msgstr "Instale somente o Libelf:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libelf.xml:69
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">make -C libelf install\n"
"install -vm644 config/libelf.pc /usr/lib/pkgconfig\n"
"rm /usr/lib/libelf.a</userinput>"
msgstr ""
"<userinput remap=\"install\">make -C libelf install\n"
"install -vm644 config/libelf.pc /usr/lib/pkgconfig\n"
"rm /usr/lib/libelf.a</userinput>"

