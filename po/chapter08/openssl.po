#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/openssl.xml:196
#, xml-text
msgid ""
"implements the Transport Layer Security (TLS v1) protocol.  It provides a "
"rich API, documentation on which can be found in <ulink role='man' "
"url='&man;ssl.7'>ssl(7)</ulink>"
msgstr ""
"implementa o protocolo &quot;Transport Layer Security&quot; (&quot;TLS "
"v1&quot;). Ela fornece uma &quot;API&quot; rica, documentação a respeito da "
"qual pode ser encontrada em &quot;<ulink role='man' "
"url='&man;ssl.7'>ssl(7)</ulink>&quot;"

