#~ "<parameter>--runstatedir=/run</parameter> e <parameter>--with-system-"
#~ "socket=/run/dbus/system_bus_socket</parameter>"

#, xml-text
#~ msgid ""
#~ "These cause the PID file and the system bus socket to be in <filename "
#~ "class=\"directory\">/run</filename>, instead of the deprecated <filename "
#~ "class=\"directory\">/var/run</filename>."
