#, xml-text
#~ msgid ""
#~ "The purpose of this switch is to prevent Coreutils from installing programs "
#~ "that will be installed by other packages."
#~ msgstr ""
#~ "O propósito dessa chave é o de impedir que o Coreutils instale aplicativos "
#~ "que serão instalados por outros pacotes."

#, xml-text
#~ msgid "First, make a fix required by glibc-2.43 and later:"
#~ msgstr "Primeiro, faça uma correção exigida pela glibc-2.43 e posteriores:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed -r '/_GL_EXTERN_C/s/w?memchr|bsearch/(&amp;)/' \\\n"
#~ "    -i $(find -name \\*.in.h)</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">sed -r '/_GL_EXTERN_C/s/w?memchr|bsearch/(&amp;)/' \\\n"
#~ "    -i $(find -name \\*.in.h)</userinput>"

#, xml-text
#~ msgid ""
#~ "Fix a bug causing the <command>cp</command> command to hang forever when "
#~ "copying sparse files on <systemitem class='filesystem'>ext4</systemitem> "
#~ "file systems:"
#~ msgstr ""
#~ "Corrija um defeito que faz com que o comando <command>cp</command> trave "
#~ "indefinidamente ao copiar arquivos esparsos em sistemas de arquivos "
#~ "<systemitem class='filesystem'>ext4</systemitem>:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed '/off_t ext_end =/s/ipos/src_pos/' -i src/copy-"
#~ "file-data.c</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">sed '/off_t ext_end =/s/ipos/src_pos/' -i src/copy-"
#~ "file-data.c</userinput>"

#, xml-text
#~ msgid "First, apply a patch for a security problem identified upstream:"
#~ msgstr ""
#~ "Primeiro, aplique um remendo para um problema de segurança identificado pelo"
#~ " fluxo de desenvolvimento:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">patch -Np1 -i ../&coreutils-upstream-"
#~ "patch;</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">patch -Np1 -i ../&coreutils-upstream-"
#~ "patch;</userinput>"

