#, xml-text
#~ msgid ""
#~ "At first, fix an issue causing the package fail to build with libxml-2.12 or"
#~ " later.  The fix is optional for building LFS, but required if rebuilding "
#~ "this package in BLFS with libxml installed:"
#~ msgstr ""
#~ "Primeiro, corrija um problema que faz com que o pacote falhe para construir "
#~ "com libxml-2.12 ou posterior. A correção é opcional para construir o LFS, "
#~ "mas exigida se reconstruir esse pacote no BLFS com libxml instalada:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed -e '/^structured/s/xmlError \\*/typeof(xmlCtxtGetLastError(NULL)) /' \\\n"
#~ "    -i gettext-tools/src/its.c</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">sed -e '/^structured/s/xmlError \\*/typeof(xmlCtxtGetLastError(NULL)) /' \\\n"
#~ "    -i gettext-tools/src/its.c</userinput>"

#, xml-text
#~ msgid "First fix some compatibility issues with other programs:"
#~ msgstr ""
#~ "Primeiro, corrija alguns problemas de compatibilidade com outros programas:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed -e '/libxml\\/xmlerror.h/i #include &lt;libxml/xmlversion.h&gt;' \\\n"
#~ "    -e 's/xmlError *err/const &amp;/'                             \\\n"
#~ "    -i gettext-tools/src/its.c</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">sed -e '/libxml\\/xmlerror.h/i #include &lt;libxml/xmlversion.h&gt;' \\\n"
#~ "    -e 's/xmlError *err/const &amp;/'                             \\\n"
#~ "    -i gettext-tools/src/its.c</userinput>"

