#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/kmod.xml:42
#, xml-text
msgid "Installation of Kmod"
msgstr "Instalação do Kmod"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/kmod.xml:44
#, xml-text
msgid "Prepare Kmod for compilation:"
msgstr "Prepare Kmod para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/kmod.xml:46
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">mkdir -p build\n"
"cd       build\n"
"\n"
"meson setup --prefix=/usr ..    \\\n"
"            --buildtype=release \\\n"
"            -D manpages=false</userinput>"
msgstr ""
"<userinput remap=\"configure\">mkdir -p build\n"
"cd       build\n"
"\n"
"meson setup --prefix=/usr ..    \\\n"
"            --buildtype=release \\\n"
"            -D manpages=false</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/kmod.xml:54
#, xml-text
msgid "The meaning of the configure options:"
msgstr "O significado das opções do configure:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/kmod.xml:58
#, xml-text
msgid "<parameter>-D manpages=false</parameter>"
msgstr "<parameter>-D manpages=false</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/kmod.xml:61
#, xml-text
msgid ""
"This option disables generating the man pages which requires an external "
"program."
msgstr ""
"Essa opção desabilita gerar as páginas de manual, o que exige um programa "
"externo."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/kmod.xml:68
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/kmod.xml:70
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">ninja</userinput>"
msgstr "<userinput remap=\"make\">ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/kmod.xml:72
#, xml-text
msgid ""
"The test suite of this package requires raw kernel headers (not the "
"<quote>sanitized</quote> kernel headers installed earlier), which are beyond"
" the scope of LFS."
msgstr ""
"A suíte de teste desse pacote exige cabeçalhos crus de núcleo (não os "
"cabeçalhos <quote>sanitizados</quote> de núcleo instalados anteriormente), "
"os quais estão além do escopo do LFS."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/kmod.xml:76
#, xml-text
msgid "Now install the package:"
msgstr "Agora instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/kmod.xml:78
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">ninja install</userinput>"
msgstr "<userinput remap=\"install\">ninja install</userinput>"

