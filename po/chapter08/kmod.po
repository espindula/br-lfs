#: lfs-en/chapter08/kmod.xml:103
#, xml-text
msgid "<command>depmod</command>"
msgstr "<command>depmod</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/kmod.xml:105
#, xml-text
msgid ""
"Creates a dependency file based on the symbols it finds in the existing set "
"of modules; this dependency file is used by <command>modprobe</command> to "
"automatically load the required modules"
msgstr ""
"Cria um arquivo de dependência baseado nos símbolos que ele encontrar no "
"conjunto existente de módulos; esse arquivo de dependência é usado pelo "
"<command>modprobe</command> para carregar automaticamente os módulos "
"exigidos"

