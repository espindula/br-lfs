#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/kmod.xml:42
#, xml-text
msgid "Installation of Kmod"
msgstr "Instalação do Kmod"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/kmod.xml:44
#, xml-text
msgid "Prepare Kmod for compilation:"
msgstr "Prepare Kmod para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/kmod.xml:46
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --with-openssl    \\\n"
"            --with-xz         \\\n"
"            --with-zstd       \\\n"
"            --with-zlib       \\\n"
"            --disable-manpages</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --with-openssl    \\\n"
"            --with-xz         \\\n"
"            --with-zstd       \\\n"
"            --with-zlib       \\\n"
"            --disable-manpages</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/kmod.xml:55
#, xml-text
msgid "The meaning of the configure options:"
msgstr "O significado das opções do configure:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/kmod.xml:59
#, xml-text
msgid "<parameter>--with-openssl</parameter>"
msgstr "<parameter>--with-openssl</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/kmod.xml:62
#, xml-text
msgid ""
"This option enables Kmod to handle PKCS7 signatures for kernel modules."
msgstr ""
"Essa opção habilita o Kmod a lidar com assinaturas PKCS7 para módulos de "
"núcleo."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/kmod.xml:69
#, xml-text
msgid ""
"<parameter>--with-xz</parameter>, <parameter>--with-zlib</parameter>, and "
"<parameter>--with-zstd</parameter>"
msgstr ""
"<parameter>--with-xz</parameter>, <parameter>--with-zlib</parameter> e "
"<parameter>--with-zstd</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/kmod.xml:74
#, xml-text
msgid "These options enable Kmod to handle compressed kernel modules."
msgstr ""
"Essas opções habilitam o Kmod a lidar com módulos comprimidos de núcleo."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/kmod.xml:80
#, xml-text
msgid "<parameter>--disable-manpages</parameter>"
msgstr "<parameter>--disable-manpages</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/kmod.xml:83
#, xml-text
msgid ""
"This option disables generating the man pages which requires an external "
"program."
msgstr ""
"Essa opção desabilita gerar as páginas de manual, o que exige um programa "
"externo."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/kmod.xml:90
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/kmod.xml:92
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/kmod.xml:94
#, xml-text
msgid ""
"The test suite of this package requires raw kernel headers (not the "
"<quote>sanitized</quote> kernel headers installed earlier), which are beyond"
" the scope of LFS."
msgstr ""
"A suíte de teste desse pacote exige cabeçalhos crus de núcleo (não os "
"cabeçalhos <quote>sanitizados</quote> de núcleo instalados anteriormente), "
"os quais estão além do escopo do LFS."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/kmod.xml:98
#, xml-text
msgid ""
"Install the package and recreate some symlinks for compatibility with "
"Module-Init-Tools (the package that previously handled Linux kernel "
"modules).  The building system will create all these symlinks in <filename "
"class='directory'>/usr/bin</filename>, but we only want "
"<command>lsmod</command> there and all other symlinks in <filename "
"class='directory'>/usr/sbin</filename> instead:"
msgstr ""
"Instale o pacote e recrie alguns links simbólicos para compatibilidade com "
"Module-Init-Tools (o pacote que anteriormente manuseava os módulos de núcleo"
" do Linux). O sistema de construção criará todos esses links simbólicos em "
"<filename class='directory'>/usr/bin</filename>, mas queremos somente "
"<command>lsmod</command> lá e todos os outros links simbólicos em <filename "
"class='directory'>/usr/sbin</filename> em vez disso:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/kmod.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">make install\n"
"\n"
"for target in depmod insmod modinfo modprobe rmmod; do\n"
"  ln -sfv ../bin/kmod /usr/sbin/$target\n"
"  rm -fv /usr/bin/$target\n"
"done</userinput>"
msgstr ""
"<userinput remap=\"install\">make install\n"
"\n"
"for target in depmod insmod modinfo modprobe rmmod; do\n"
"  ln -sfv ../bin/kmod /usr/sbin/$target\n"
"  rm -fv /usr/bin/$target\n"
"done</userinput>"

