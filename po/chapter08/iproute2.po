#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:149
#, xml-text
msgid ""
"The main executable. It has several different functions, including these:"
msgstr "O executável principal. Ele tem várias funções, incluindo estas:"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:151
#, xml-text
msgid ""
"<command>ip link <replaceable>&lt;device&gt;</replaceable></command> allows "
"users to look at the state of devices and to make changes"
msgstr ""
"<command>ip link <replaceable>&lt;dispositivo&gt;</replaceable></command> "
"permite que usuários(as) olhem para o estado de dispositivos e façam "
"mudanças"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:154
#, xml-text
msgid ""
"<command>ip addr</command> allows users to look at addresses and their "
"properties, add new addresses, and delete old ones"
msgstr ""
"<command>ip addr</command> permite que usuários(as) olhem para endereços e "
"propriedades deles, adicionem novos endereços e deletem os antigos"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:157
#, xml-text
msgid ""
"<command>ip neighbor</command> allows users to look at neighbor bindings and"
" their properties, add new neighbor entries, and delete old ones"
msgstr ""
"<command>ip neighbor</command> permite que usuários(as) olhem para vínculos "
"de vizinho e propriedades deles, adicionem novas entradas de vizinho e "
"deletem as antigas"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:161
#, xml-text
msgid ""
"<command>ip rule</command> allows users to look at the routing policies and "
"change them"
msgstr ""
"<command>ip rule</command> permite que usuários(as) olhem para as políticas "
"de roteamento e as mudem"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:164
#, xml-text
msgid ""
"<command>ip route</command> allows users to look at the routing table and "
"change routing table rules"
msgstr ""
"<command>ip route</command> permite que usuários(as) olhem para a tabela de "
"roteamento e mudem regras da tabela de roteamento"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:167
#, xml-text
msgid ""
"<command>ip tunnel</command> allows users to look at the IP tunnels and "
"their properties, and change them"
msgstr ""
"<command>ip tunnel</command> permite que usuários(as) olhem para os tuneis "
"IP e propriedades deles e as mudem"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:170
#, xml-text
msgid ""
"<command>ip maddr</command> allows users to look at the multicast addresses "
"and their properties, and change them"
msgstr ""
"<command>ip maddr</command> permite que usuários(as) olhem para os endereços"
" multicast e propriedades deles e as mudem"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:173
#, xml-text
msgid ""
"<command>ip mroute</command> allows users to set, change, or delete the "
"multicast routing"
msgstr ""
"<command>ip mroute</command> permite que usuários(as) configurem, mudem ou "
"deletem o roteamento multicast"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/iproute2.xml:176
#, xml-text
msgid ""
"<command>ip monitor</command> allows users to continuously monitor the state"
" of devices, addresses and routes"
msgstr ""
"<command>ip monitor</command> permite que usuários(as) continuamente "
"monitorem o estado de dispositivos, endereços e rotas"

