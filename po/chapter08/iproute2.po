#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/iproute2.xml:42
#, xml-text
msgid "Installation of IPRoute2"
msgstr "Instalação do IPRoute2"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/iproute2.xml:44
#, xml-text
msgid ""
"The <command>arpd</command> program included in this package will not be "
"built since it depends on Berkeley DB, which is not installed in LFS. "
"However, a directory and a man page for <command>arpd</command> will still "
"be installed. Prevent this by running the commands shown below."
msgstr ""
"O aplicativo <command>arpd</command> incluído nesse pacote não será "
"construído, dado que ele é dependente do Berkeley DB, o qual não é instalado"
" no LFS. Entretanto, um diretório e uma página de manual para o "
"<command>arpd</command> ainda serão instalados. Impeça isso executando os "
"comandos mostrados abaixo."

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/iproute2.xml:50
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i /ARPD/d Makefile\n"
"rm -fv man/man8/arpd.8</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i /ARPD/d Makefile\n"
"rm -fv man/man8/arpd.8</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/iproute2.xml:59
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/iproute2.xml:61
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make NETNS_RUN_DIR=/run/netns</userinput>"
msgstr "<userinput remap=\"make\">make NETNS_RUN_DIR=/run/netns</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/iproute2.xml:63
#, xml-text
msgid "This package does not have a working test suite."
msgstr "Esse pacote não tem uma suíte de teste funcional."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/iproute2.xml:74
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/iproute2.xml:76
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make SBINDIR=/usr/sbin install</userinput>"
msgstr "<userinput remap=\"install\">make SBINDIR=/usr/sbin install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/iproute2.xml:78
#, xml-text
msgid "If desired, install the documentation:"
msgstr "Se desejado, instale a documentação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/iproute2.xml:80
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">install -vDm644 COPYING README* -t "
"/usr/share/doc/iproute2-&iproute2-version;</userinput>"
msgstr ""
"<userinput remap=\"install\">install -vDm644 COPYING README* -t /usr/share/"
"doc/iproute2-&iproute2-version;</userinput>"

