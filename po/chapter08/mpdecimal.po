#: lfs-en/chapter08/mpdecimal.xml:27
#, xml-text
msgid ""
"The mpdecimal package contains fast C/C++ libraries for correctly-rounded "
"arbitrary precision decimal floating point arithmetic."
msgstr ""
"O pacote mpdecimal contém bibliotecas rápidas C/C++ para aritmética de ponto"
" flutuante decimal de precisão arbitrária com arredondamento correto."

