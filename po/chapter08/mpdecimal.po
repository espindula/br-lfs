#: lfs-en/chapter08/mpdecimal.xml:44
#, xml-text
msgid "Installation of mpdecimal"
msgstr "Instalação do mpdecimal"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/mpdecimal.xml:46
#, xml-text
msgid "Prepare mpdecimal for compilation:"
msgstr "Prepare mpdecimal para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/mpdecimal.xml:48
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/mpdecimal-&mpdecimal-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/mpdecimal-&mpdecimal-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/mpdecimal.xml:52
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/mpdecimal.xml:54
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/mpdecimal.xml:56
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/mpdecimal.xml:58
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check_local</userinput>"
msgstr "<userinput remap=\"test\">make check_local</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/mpdecimal.xml:60
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/mpdecimal.xml:62
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

