#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/zlib.xml:42
#, xml-text
msgid "Installation of Zlib"
msgstr "Instalação do Zlib"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/zlib.xml:44
#, xml-text
msgid "Prepare Zlib for compilation:"
msgstr "Prepare o Zlib para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/zlib.xml:46
#, no-wrap, xml-text
msgid "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"
msgstr "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/zlib.xml:48
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/zlib.xml:50
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/zlib.xml:52
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/zlib.xml:54
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check</userinput>"
msgstr "<userinput remap=\"test\">make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/zlib.xml:56
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/zlib.xml:58
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/zlib.xml:60
#, xml-text
msgid "Remove a useless static library:"
msgstr "Remova uma biblioteca estática inútil:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/zlib.xml:62
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">rm -fv /usr/lib/libz.a</userinput>"
msgstr "<userinput remap=\"install\">rm -fv /usr/lib/libz.a</userinput>"

