"<userinput remap=\"configure\">./configure --prefix=/usr      \\\n"
"            --sysconfdir=/etc  \\\n"
"            --runstatedir=/run \\\n"
"            --without-logger   \\\n"
"            --disable-static   \\\n"
"            --docdir=/usr/share/doc/sysklogd-&sysklogd-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr      \\\n"
"            --sysconfdir=/etc  \\\n"
"            --runstatedir=/run \\\n"
"            --without-logger   \\\n"
