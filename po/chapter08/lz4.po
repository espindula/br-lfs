#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/lz4.xml:48
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make BUILD_STATIC=no PREFIX=/usr</userinput>"
msgstr "<userinput remap=\"make\">make BUILD_STATIC=no PREFIX=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/lz4.xml:50
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#.  This needs to be done at -j1 because otherwise test files do not
#.          get generated correctly.
#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/lz4.xml:55
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make -j1 check</userinput>"
msgstr "<userinput remap=\"test\">make -j1 check</userinput>"

