#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/gawk.xml:100
#, xml-text
msgid "awk (link to gawk), gawk, and gawk-&gawk-version;"
msgstr "awk (link para gawk), gawk e awk-&gawk-version;"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/gawk.xml:101
#, xml-text
msgid ""
"filefuncs.so, fnmatch.so, fork.so, inplace.so, intdiv.so, ordchr.so, "
"readdir.so, readfile.so, revoutput.so, revtwoway.so, rwarray.so, and time.so"
" (all in /usr/lib/gawk)"
msgstr ""
"filefuncs.so, fnmatch.so, fork.so, inplace.so, intdiv.so, ordchr.so, "
"readdir.so, readfile.so, revoutput.so, revtwoway.so, rwarray.so e time.so "
"(todas em /usr/lib/gawk)"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/gawk.xml:104
#, xml-text
msgid ""
"/usr/lib/gawk, /usr/libexec/awk, /usr/share/awk, and "
"/usr/share/doc/gawk-&gawk-version;"
msgstr ""
"/usr/lib/gawk, /usr/libexec/awk, /usr/share/awk e /usr/share/doc/gawk-&gawk-"
"version;"

