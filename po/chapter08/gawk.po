#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/gawk.xml:41
#, xml-text
msgid "Installation of Gawk"
msgstr "Instalação do Gawk"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/gawk.xml:43
#, xml-text
msgid "First, ensure some unneeded files are not installed:"
msgstr ""
"Primeiro, garanta que alguns arquivos desnecessários não sejam instalados:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/gawk.xml:45
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">sed -i 's/extras//' Makefile.in</userinput>"
msgstr "<userinput remap=\"pre\">sed -i 's/extras//' Makefile.in</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/gawk.xml:47
#, xml-text
msgid "Prepare Gawk for compilation:"
msgstr "Prepare o Gawk para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/gawk.xml:49
#, no-wrap, xml-text
msgid "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"
msgstr "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/gawk.xml:51
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/gawk.xml:53
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/gawk.xml:55
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/gawk.xml:57
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"test\">chown -R tester .\n"
"su tester -c \"PATH=$PATH make check\"</userinput>"
msgstr ""
"<userinput remap=\"test\">chown -R tester .\n"
"su tester -c \"PATH=$PATH make check\"</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/gawk.xml:60
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/gawk.xml:62
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">rm -f /usr/bin/gawk-&gawk-version;\n"
"make install</userinput>"
msgstr ""
"<userinput remap=\"install\">rm -f /usr/bin/gawk-&gawk-version;\n"
"make install</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/gawk.xml:66
#, xml-text
msgid "The meaning of the command:"
msgstr "O significado do comando:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/gawk.xml:69
#, xml-text
msgid "<command>rm -f /usr/bin/gawk-&gawk-version;</command>"
msgstr "<command>rm -f /usr/bin/gawk-&gawk-version;</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/gawk.xml:71
#, xml-text
msgid ""
"The building system will not recreate the hard link <filename>gawk-&gawk-"
"version;</filename> if it already exists.  Remove it to ensure that the "
"previous hard link installed in <xref linkend='ch-tools-gawk'/> is updated "
"here."
msgstr ""
"O sistema de construção não recriará o link rígido <filename>gawk-&gawk-"
"version;</filename> se ele já existir. Remova-o para garantir que o link "
"rígido anterior instalado na <xref linkend='ch-tools-gawk'/> seja atualizado"
" aqui."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/gawk.xml:79
#, xml-text
msgid ""
"The installation process already created <command>awk</command> as a symlink"
" to <command>gawk</command>, create its man page as a symlink as well:"
msgstr ""
"O processo de instalação já criou <command>awk</command> como um link "
"simbólico para <command>gawk</command>; crie a página de manual dele como um"
" link simbólico também:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/gawk.xml:83
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">ln -sv gawk.1 "
"/usr/share/man/man1/awk.1</userinput>"
msgstr ""
"<userinput remap=\"install\">ln -sv gawk.1 "
"/usr/share/man/man1/awk.1</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/gawk.xml:85
#, xml-text
msgid "If desired, install the documentation:"
msgstr "Se desejado, instale a documentação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/gawk.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">install -vDm644 "
"doc/{awkforai.txt,*.{eps,pdf,jpg}} -t /usr/share/doc/gawk-&gawk-"
"version;</userinput>"
msgstr ""
"<userinput remap=\"install\">install -vDm644 doc/{awkforai."
"txt,*.{eps,pdf,jpg}} -t /usr/share/doc/gawk-&gawk-version;</userinput>"

