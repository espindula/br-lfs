#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/udev.xml:253
#, xml-text
msgid ""
"Generic udev administration tool: controls the udevd daemon, provides info "
"from the Udev database, monitors uevents, waits for uevents to finish, tests"
" Udev configuration, and triggers uevents for a given device"
msgstr ""
"Ferramenta genérica de administração do \"udev\": controla o processo de "
"segundo plano \"udevd\"; fornece informações a partir da base de dados do "
"\"Udev\"; monitora \"uevents\"; aguarda \"uevents\" finalizarem; testa a "
"configuração do \"Udev\"; e aciona \"uevents\" para um dado dispositivo"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: lfs-en/chapter08/udev.xml:258
#, xml-text
msgid "udevadm"
msgstr "udevadm"

