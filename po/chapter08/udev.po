#~ msgstr "Corrija um defeito que impede o udev de executar corretamente:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed -i \"/udev_dependencies,/a \\                "
#~ "'link_with': udev_link_with,\" src/udev/meson.build</userinput>"
