#. type: Content of: <sect1><title>
#: lfs-en/chapter08/udev.xml:17
#, xml-text
msgid "Udev from Systemd-&systemd-version;"
msgstr "Udev originário de Systemd-&systemd-version;"

#. type: Content of: <sect1><sect2><indexterm><primary>
#: lfs-en/chapter08/udev.xml:20 lfs-en/chapter08/udev.xml:207
#, xml-text
msgid "Udev"
msgstr "Udev"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:26
#, xml-text
msgid ""
"The Udev package contains programs for dynamic creation of device nodes."
msgstr ""
"O pacote \"Udev\" contém aplicativos para criação dinâmica de nós de "
"dispositivos."

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: lfs-en/chapter08/udev.xml:30
#, xml-text
msgid "&buildtime;"
msgstr "&buildtime;"

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: lfs-en/chapter08/udev.xml:31
#, xml-text
msgid "&diskspace;"
msgstr "&diskspace;"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/udev.xml:34
#, xml-text
msgid "&udev-fin-sbu;"
msgstr "&udev-fin-sbu;"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/udev.xml:35
#, xml-text
msgid "&udev-fin-du;"
msgstr "&udev-fin-du;"

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/udev.xml:41
#, xml-text
msgid "Installation of Udev"
msgstr "Instalação do \"Udev\""

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:43
#, xml-text
msgid ""
"Udev is part of the systemd-&systemd-version; package. Use the "
"systemd-&systemd-version;.tar.xz file as the source tarball."
msgstr ""
"O \"Udev\" é parte do pacote systemd-&systemd-version;. Use o arquivo "
"systemd-&systemd-version;.tar.xz como o tarball fonte."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:46
#, xml-text
msgid ""
"Remove two unneeded groups, <systemitem "
"class=\"groupname\">render</systemitem> and <systemitem "
"class=\"groupname\">sgx</systemitem>, from the default udev rules:"
msgstr ""
"Remova dois grupos desnecessários, <systemitem "
"class=\"groupname\">render</systemitem> e <systemitem "
"class=\"groupname\">sgx</systemitem>, das regras padrão do \"udev\":"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:51
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -e 's/GROUP=\"render\"/GROUP=\"video\"/' \\\n"
"    -e 's/GROUP=\"sgx\", //'               \\\n"
"    -i rules.d/50-udev-default.rules.in</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -e 's/GROUP=\"render\"/GROUP=\"video\"/' \\\n"
"    -e 's/GROUP=\"sgx\", //'               \\\n"
"    -i rules.d/50-udev-default.rules.in</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:55
#, xml-text
msgid "Remove one udev rule requiring a full Systemd installation:"
msgstr ""
"Remova uma regra do \"udev\" que exige uma instalação completa do "
"\"Systemd\":"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:57
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/systemd-sysctl/s/^/#/' "
"rules.d/99-systemd.rules.in</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i '/systemd-sysctl/s/^/#/' "
"rules.d/99-systemd.rules.in</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:63
#, xml-text
msgid ""
"Adjust the hardcoded paths to network configuration files for the standalone"
" udev installation:"
msgstr ""
"Ajuste os caminhos rigidamente codificados para os arquivos de configuração "
"da rede de intercomunicação para a instalação autônoma do &quot;Udev&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:66
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -e '/NETWORK_DIRS/s/systemd/udev/' \\\n"
"    -i src/libsystemd/sd-network/network-util.h</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -e '/NETWORK_DIRS/s/systemd/udev/' \\\n"
"    -i src/libsystemd/sd-network/network-util.h</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:69
#, xml-text
msgid "Prepare Udev for compilation:"
msgstr "Prepare o \"Udev\" para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:71
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">mkdir -p build\n"
"cd       build\n"
"\n"
"meson setup ..                  \\\n"
"      --prefix=/usr             \\\n"
"      --buildtype=release       \\\n"
"      -D mode=release           \\\n"
"      -D dev-kvm-mode=0660      \\\n"
"      -D link-udev-shared=false \\\n"
"      -D logind=false           \\\n"
"      -D vconsole=false</userinput>"
msgstr ""
"<userinput remap=\"configure\">mkdir -p build\n"
"cd       build\n"
"\n"
"meson setup ..                  \\\n"
"      --prefix=/usr             \\\n"
"      --buildtype=release       \\\n"
"      -D mode=release           \\\n"
"      -D dev-kvm-mode=0660      \\\n"
"      -D link-udev-shared=false \\\n"
"      -D logind=false           \\\n"
"      -D vconsole=false</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/udev.xml:84
#, xml-text
msgid "The meaning of the meson options:"
msgstr "O significado das opções \"meson\":"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/udev.xml:87
#, xml-text
msgid "<parameter>--buildtype=release</parameter>"
msgstr "<parameter>--buildtype=release</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/udev.xml:89
#, xml-text
msgid ""
"This switch overrides the default buildtype (<quote>debug</quote>), which "
"produces unoptimized binaries."
msgstr ""
"Essa chave substitui o tipo de construção padrão (<quote>debug</quote>), que"
" produz binários não otimizados."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/udev.xml:96
#, xml-text
msgid "<parameter>-D mode=release</parameter>"
msgstr "<parameter>-D mode=release</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/udev.xml:98
#, xml-text
msgid "Disable some features considered experimental by upstream."
msgstr ""
"Desabilite alguns recursos considerados experimentais pelo(a) "
"desenvolvedor(a)."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/udev.xml:104
#, xml-text
msgid "<parameter>-D dev-kvm-mode=0660</parameter>"
msgstr "<parameter>-D dev-kvm-mode=0660</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/udev.xml:106
#, xml-text
msgid ""
"The default udev rule would allow all users to access <filename "
"class='devicefile'>/dev/kvm</filename>.  The editors consider it dangerous."
"  This option overrides it."
msgstr ""
"A regra padrão do \"udev\" permitiria que todos(as) os(as) usuários(as) "
"acessassem <filename class='devicefile'>/dev/kvm</filename>. Os(As) "
"editores(as) a consideram perigosa. Essa opção a substitui."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/udev.xml:113
#, xml-text
msgid "<parameter>-D link-udev-shared=false</parameter>"
msgstr "<parameter>-D link-udev-shared=false</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/udev.xml:115
#, xml-text
msgid ""
"This option prevents udev from linking to the internal systemd shared "
"library, <systemitem class='library'>libsystemd-shared</systemitem>.  This "
"library is designed to be shared by many Systemd components and it's too "
"overkill for a udev-only installation."
msgstr ""
"Essa opção evita que o \"udev\" se vincule à biblioteca interna "
"compartilhada do \"systemd\", <systemitem class='library'>libsystemd-"
"shared</systemitem>. Essa biblioteca foi projetada para ser compartilhada "
"por muitos componentes do \"Systemd\" e é muito exagerada para uma "
"instalação somente do \"udev\"."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/udev.xml:124
#, xml-text
msgid "<parameter>-D logind=false -D vconsole=false</parameter>"
msgstr "<parameter>-D logind=false -D vconsole=false</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/udev.xml:126
#, xml-text
msgid ""
"These options prevent the generation of several udev rule files belonging to"
" the other Systemd components that we won't install."
msgstr ""
"Essas opções evitam a geração de vários arquivos de regras do "
"&quot;Udev&quot; pertencentes a outros componentes do &quot;Systemd&quot; "
"que nós não instalaremos."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:133
#, xml-text
msgid ""
"Get the list of the shipped udev helpers and save it into an environment "
"variable (exporting it is not strictly necessary, but it makes building as a"
" regular user or using a package manager easier):"
msgstr ""
"Obtenha a lista dos auxiliares &quot;Udev&quot; enviados e salve-a em uma "
"variável de ambiente (exportá-la não é estritamente necessário, mas facilita"
" construir como um(a) usuário(a) comum ou usar um gerenciador de pacotes):"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"make\">export udev_helpers=$(grep \"'name' :\" ../src/udev/meson.build | \\\n"
"                      awk '{print $3}' | tr -d \",'\" | grep -v 'udevadm')</userinput>"
msgstr ""
"<userinput remap=\"make\">export udev_helpers=$(grep \"'name' :\" ../src/udev/meson.build | \\\n"
"                       awk '{print $3}' | tr -d \",'\" | grep -v 'udevadm')</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:140
#, xml-text
msgid "Only build the components needed for udev:"
msgstr "Construa somente os componentes necessários para o \"udev\":"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:142
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"make\">ninja udevadm systemd-hwdb                                           \\\n"
"      $(ninja -n | grep -Eo '(src/(lib)?udev|rules.d|hwdb.d)/[^ ]*') \\\n"
"      $(realpath libudev.so --relative-to .)                         \\\n"
"      $udev_helpers</userinput>"
msgstr ""
"<userinput remap=\"make\">ninja udevadm systemd-hwdb                                            \\\n"
"      $(ninja -n | grep -Eo '(src/(lib)?udev|rules.d|hwdb.d)/[^ ]*') \\\n"
"      $(realpath libudev.so --relative-to .)                         \\\n"
"      $udev_helpers</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:147
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:149
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">install -vm755 -d {/usr/lib,/etc}/udev/{hwdb.d,rules.d,network}\n"
"install -vm755 -d /usr/{lib,share}/pkgconfig\n"
"install -vm755 udevadm                             /usr/bin/\n"
"install -vm755 systemd-hwdb                        /usr/bin/udev-hwdb\n"
"ln      -svfn  ../bin/udevadm                      /usr/sbin/udevd\n"
"cp      -av    libudev.so{,*[0-9]}                 /usr/lib/\n"
"install -vm644 ../src/libudev/libudev.h            /usr/include/\n"
"install -vm644 src/libudev/*.pc                    /usr/lib/pkgconfig/\n"
"install -vm644 src/udev/*.pc                       /usr/share/pkgconfig/\n"
"install -vm644 ../src/udev/udev.conf               /etc/udev/\n"
"install -vm644 rules.d/* ../rules.d/README         /usr/lib/udev/rules.d/\n"
"install -vm644 $(find ../rules.d/*.rules \\\n"
"                      -not -name '*power-switch*') /usr/lib/udev/rules.d/\n"
"install -vm644 hwdb.d/*  ../hwdb.d/{*.hwdb,README} /usr/lib/udev/hwdb.d/\n"
"install -vm755 $udev_helpers                       /usr/lib/udev\n"
"install -vm644 ../network/99-default.link          /usr/lib/udev/network</userinput>"
msgstr ""
"<userinput remap=\"install\">install -vm755 -d {/usr/lib,/etc}/udev/{hwdb.d,rules.d,network}\n"
"install -vm755 -d /usr/{lib,share}/pkgconfig\n"
"install -vm755 udevadm                            /usr/bin/\n"
"install -vm755 systemd-hwdb                        /usr/bin/udev-hwdb\n"
"ln      -svfn  ../bin/udevadm                      /usr/sbin/udevd\n"
"cp      -av    libudev.so{,*[0-9]}                 /usr/lib/\n"
"install -vm644 ../src/libudev/libudev.h            /usr/include/\n"
"install -vm644 src/libudev/*.pc                    /usr/lib/pkgconfig/\n"
"install -vm644 src/udev/*.pc                       /usr/share/pkgconfig/\n"
"install -vm644 ../src/udev/udev.conf               /etc/udev/\n"
"install -vm644 rules.d/* ../rules.d/README         /usr/lib/udev/rules.d/\n"
"install -vm644 $(find ../rules.d/*.rules \\\n"
"                      -not -name '*power-switch*') /usr/lib/udev/rules.d/\n"
"install -vm644 hwdb.d/*  ../hwdb.d/{*.hwdb,README} /usr/lib/udev/hwdb.d/\n"
"install -vm755 $udev_helpers                       /usr/lib/udev\n"
"install -vm644 ../network/99-default.link          /usr/lib/udev/network</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:166
#, xml-text
msgid ""
"Install some custom rules and support files useful in an LFS environment:"
msgstr ""
"Instale algumas regras personalizadas e arquivos de suporte úteis em um "
"ambiente LFS:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:169
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">tar -xvf ../../&udev-lfs-version;.tar.xz\n"
"make -f &udev-lfs-version;/Makefile.lfs install</userinput>"
msgstr ""
"<userinput remap=\"install\">tar -xvf ../../&udev-lfs-version;.tar.xz\n"
"make -f &udev-lfs-version;/Makefile.lfs install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:172
#, xml-text
msgid "Install the man pages:"
msgstr "Instale as páginas de manual:"

#.  Please make sure systemd man pages tarball has a common leading
#.          component in the path.
#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:176
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">tar -xf ../../systemd-man-pages-&systemd-man-version;.tar.xz                          \\\n"
"    --no-same-owner --strip-components=1                              \\\n"
"    -C /usr/share/man --wildcards '*/udev*' '*/libudev*'              \\\n"
"                                  '*/systemd.link.5'                  \\\n"
"                                  '*/systemd-'{hwdb,udevd.service}.8\n"
"\n"
"sed 's|systemd/network|udev/network|'                                 \\\n"
"    /usr/share/man/man5/systemd.link.5                                \\\n"
"  > /usr/share/man/man5/udev.link.5\n"
"\n"
"sed 's/systemd\\(\\\\\\?-\\)/udev\\1/' /usr/share/man/man8/systemd-hwdb.8   \\\n"
"                               > /usr/share/man/man8/udev-hwdb.8\n"
"\n"
"sed 's|lib.*udevd|sbin/udevd|'                                        \\\n"
"    /usr/share/man/man8/systemd-udevd.service.8                       \\\n"
"  > /usr/share/man/man8/udevd.8\n"
"\n"
"rm /usr/share/man/man*/systemd*</userinput>"
msgstr ""
"<userinput remap=\"install\">tar -xf ../../systemd-man-pages-&systemd-man-"
"version;.tar.xz                          \\\n"
"    --no-same-owner --strip-components=1                              \\\n"
"    -C /usr/share/man --wildcards '*/udev*' '*/libudev*'              \\\n"
"                                  '*/systemd.link.5'                  \\\n"
"                                  '*/systemd-'{hwdb,udevd.service}.8\n"
"\n"
"sed 's|systemd/network|udev/network|'                                 \\\n"
"    /usr/share/man/man5/systemd.link.5                                \\\n"
"  > /usr/share/man/man5/udev.link.5\n"
"\n"
"sed 's/systemd\\(\\\\\\?-\\)/udev\\1/' /usr/share/man/man8/systemd-hwdb.8   "
"\\\n"
"                               > /usr/share/man/man8/udev-hwdb.8\n"
"\n"
"sed 's|lib.*udevd|sbin/udevd|'                                        \\\n"
"    /usr/share/man/man8/systemd-udevd.service.8                       \\\n"
"  > /usr/share/man/man8/udevd.8\n"
"\n"
"rm /usr/share/man/man*/systemd*</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:195
#, xml-text
msgid "Finally, unset the <envar>udev_helpers</envar> variable:"
msgstr ""
"Finalmente, desconfigure a variável &quot;<envar>udev_helpers</envar>&quot;:"

#.  remap="make" seems confusing but we don't have sth. like
#.          remap="clean".
#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:199
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">unset udev_helpers</userinput>"
msgstr "<userinput remap=\"install\">unset udev_helpers</userinput>"

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/udev.xml:204
#, xml-text
msgid "Configuring Udev"
msgstr "Configurando o \"Udev\""

#. type: Content of: <sect1><sect2><indexterm><secondary>
#: lfs-en/chapter08/udev.xml:208
#, xml-text
msgid "configuring"
msgstr "configurando"

#. type: Content of: <sect1><sect2><indexterm><primary>
#: lfs-en/chapter08/udev.xml:212
#, xml-text
msgid "/etc/udev/hwdb.bin"
msgstr "/etc/udev/hwdb.bin"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:215
#, xml-text
msgid ""
"Information about hardware devices is maintained in the <filename "
"class=\"directory\">/etc/udev/hwdb.d</filename> and <filename "
"class=\"directory\">/usr/lib/udev/hwdb.d</filename> directories.  "
"<application>Udev</application> needs that information to be compiled into a"
" binary database <filename>/etc/udev/hwdb.bin</filename>. Create the initial"
" database:"
msgstr ""
"Informações acerca de dispositivos de hardware são mantidas nos diretórios "
"<filename class=\"directory\">/etc/udev/hwdb.d</filename> e <filename "
"class=\"directory\">/usr/lib/udev/hwdb.d</filename>. O "
"<application>Udev</application> precisa que essas informações sejam "
"compiladas em uma base de dados binária "
"<filename>/etc/udev/hwdb.bin</filename>. Crie a base de dados inicial:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/udev.xml:222
#, no-wrap, xml-text
msgid "<userinput>udev-hwdb update</userinput>"
msgstr "<userinput>udev-hwdb update</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/udev.xml:224
#, xml-text
msgid ""
"This command needs to be run each time the hardware information is updated."
msgstr ""
"Esse comando precisa ser executado sempre que as informações de hardware "
"forem atualizadas."

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/udev.xml:230
#, xml-text
msgid "Contents of Udev"
msgstr "Conteúdo do \"Udev\""

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: lfs-en/chapter08/udev.xml:233
#, xml-text
msgid "Installed programs"
msgstr "Aplicativos instalados"

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: lfs-en/chapter08/udev.xml:234
#, xml-text
msgid "Installed libraries"
msgstr "Bibliotecas instaladas"

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: lfs-en/chapter08/udev.xml:235
#, xml-text
msgid "Installed directories"
msgstr "Diretórios instalados"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/udev.xml:238
#, xml-text
msgid "udevadm, udevd (symlink to udevadm), and udev-hwdb"
msgstr "udevadm, udevd (link simbólico para udevadm) e udev-hwdb"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/udev.xml:240
#, xml-text
msgid "libudev.so"
msgstr "libudev.so"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: lfs-en/chapter08/udev.xml:242
#, xml-text
msgid "/etc/udev and /usr/lib/udev"
msgstr "/etc/udev e /usr/lib/udev"

