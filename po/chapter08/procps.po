#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/procps.xml:43
#, xml-text
msgid "Prepare Procps-ng for compilation:"
msgstr "Prepare procps-ng para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/procps.xml:45
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr                           \\\n"
"            --docdir=/usr/share/doc/procps-ng-&procps-ng-version; \\\n"
"            --disable-static                        \\\n"
"            --disable-kill                          \\\n"
"            --enable-watch8bit</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr                           \\\n"
"            --docdir=/usr/share/doc/procps-ng-&procps-ng-version; \\\n"
"            --disable-static                        \\\n"
"            --disable-kill                          \\\n"
"            --enable-watch8bit</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/procps.xml:51
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr                           \\\n"
"            --docdir=/usr/share/doc/procps-ng-&procps-ng-version; \\\n"
"            --disable-static                        \\\n"
"            --disable-kill                          \\\n"
"            --enable-watch8bit                      \\\n"
"            --with-systemd</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr                           \\\n"
"            --docdir=/usr/share/doc/procps-ng-&procps-ng-version; \\\n"
"            --disable-static                        \\\n"
"            --disable-kill                          \\\n"
"            --enable-watch8bit                      \\\n"
"            --with-systemd</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/procps.xml:59
#, xml-text
msgid "The meaning of the configure option:"
msgstr "O significado da opção de configure:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/procps.xml:62
#, xml-text
msgid "<parameter>--disable-kill</parameter>"
msgstr "<parameter>--disable-kill</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/procps.xml:64
#, xml-text
msgid ""
"This switch disables building the <command>kill</command> command; it will "
"be installed from the Util-linux package."
msgstr ""
"Essa chave desabilita a construção do comando <command>kill</command>; ele "
"será instalado a partir do pacote Util-linux."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/procps.xml:70
#, xml-text
msgid "<parameter>--enable-watch8bit</parameter>"
msgstr "<parameter>--enable-watch8bit</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/procps.xml:72
#, xml-text
msgid ""
"This switch enables the ncursesw support for the <command>watch</command> "
"command, so it can handle 8-bit characters."
msgstr ""
"Essa chave habilita o suporte ncursesw para o comando "
"<command>watch</command>, de forma que ele consiga manusear caracteres de 8 "
"bits."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/procps.xml:79
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/procps.xml:81
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/procps.xml:86
#, xml-text
msgid "To run the test suite, run:"
msgstr "Para executar a suíte de teste, execute:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/procps.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"test\">chown -R tester .\n"
"su tester -c \"PATH=$PATH make check\"</userinput>"
msgstr ""
"<userinput remap=\"test\">chown -R tester .\n"
"su tester -c \"PATH=$PATH make check\"</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/procps.xml:91
#, xml-text
msgid ""
"One test named <literal>ps with output flag "
"bsdtime,cputime,etime,etimes</literal> is known to fail if the host kernel "
"is not built with <literal>CONFIG_BSD_PROCESS_ACCT</literal> enabled."
msgstr ""
"Um teste chamado <literal>ps com sinalizador de saída "
"bsdtime,cputime,etime,etimes</literal> é conhecido por falhar se o núcleo do "
"anfitrião não for construído com <literal>CONFIG_BSD_PROCESS_ACCT</literal> "
"habilitado."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/procps.xml:96
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/procps.xml:98
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

