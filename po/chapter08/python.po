#, xml-text
#~ msgid "First, fix a security vulnerability in the tarfile module:"
#~ msgstr "Primeiro, corrija uma vulnerabilidade de segurança no módulo tarfile:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed -e '/Round/{n;n;a\\\n"
#~ "        # Only non-negative offsets are allowed\\\n"
#~ "        if count &lt; 0:\\\n"
#~ "            raise InvalidHeaderError(\"invalid offset\")\n"
#~ "}' -i Lib/tarfile.py</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">sed -e '/Round/{n;n;a\\\n"
#~ "        # Somente compensações não negativas são permitidas\\\n"
#~ "        if count &lt; 0:\\\n"
#~ "            raise InvalidHeaderError(\"invalid offset\")\n"
#~ "}' -i Lib/tarfile.py</userinput>"

