#, xml-text
#~ msgid "<command>2to3</command>"
#~ msgstr "<command>2to3</command>"

#, xml-text
#~ msgid ""
#~ "is a <application>Python</application> program that reads "
#~ "<application>Python 2.x</application> source code and applies a series of "
#~ "fixes to transform it into valid <application>Python 3.x</application> code"
#~ msgstr ""
#~ "é um aplicativo <application>Python</application> que lê código fonte "
#~ "<application>Python 2.x</application> e aplica uma série de correções para "
#~ "transformá-lo em código <application>Python 3.x</application> válido"

