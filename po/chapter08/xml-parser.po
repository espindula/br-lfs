#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/xml-parser.xml:42
#, xml-text
msgid "Installation of XML::Parser"
msgstr "Instalação do XML::Parser"

#. type: Content of: <sect1><sect2><note><para>
#: lfs-en/chapter08/xml-parser.xml:45
#, xml-text
msgid ""
"This package is scheduled to move to BLFS.  Until that can be done, two Perl"
" modules need to be added.  To do that, we also have to enable DNS by "
"temporarily adding /etc/resolv.conf."
msgstr ""
"Esse pacote está agendado para mover para o BLFS. Até que isso possa ser "
"feito, dois módulos Perl precisam ser adicionados. Para fazer isso, nós "
"também temos que habilitar o DNS adicionando temporariamente "
"/etc/resolv.conf."

#. type: Content of: <sect1><sect2><note><screen>
#: lfs-en/chapter08/xml-parser.xml:49
#, no-wrap, xml-text
msgid ""
"<userinput role=\"nodump\">cat > /etc/resolv.conf &lt;&lt; EOF\n"
"nameserver 8.8.8.8\n"
"nameserver 8.8.4.4\n"
"EOF</userinput>"
msgstr ""
"<userinput role=\"nodump\">cat > /etc/resolv.conf &lt;&lt; EOF\n"
"nameserver 8.8.8.8\n"
"nameserver 8.8.4.4\n"
"EOF</userinput>"

#. type: Content of: <sect1><sect2><note><para>
#: lfs-en/chapter08/xml-parser.xml:54
#, xml-text
msgid ""
"Alternatively, you may skip this package and the next package (intltool) as "
"nothing else in LFS needs them.  When you build a BLFS package requiring "
"XML::Parser or intltool, install those modules following <ulink url='&blfs-"
"book;general/perl-deps.html#perl-file-sharedir'>the BLFS "
"instruction</ulink>, and then install this package."
msgstr ""
"Alternativamente, você pode ignorar esse pacote e o próximo (intltool), pois"
" nada mais no LFS precisa deles. Quando você construir um pacote do BLFS que"
" exija XML::Parser ou intltool, instale esses módulos seguindo <ulink "
"url='&blfs-book;general/perl-deps.html#perl-file-sharedir'>as instruções do "
"BLFS</ulink> e, então, instale esse pacote."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/xml-parser.xml:62
#, xml-text
msgid "Now add two Perl modules:"
msgstr "Agora adicione dois módulos Perl:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/xml-parser.xml:64
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">yes | cpan -i File::ShareDir\n"
"yes | cpan -i File::ShareDir::Install</userinput>"
msgstr ""
"<userinput remap=\"pre\">yes | cpan -i File::ShareDir\n"
"yes | cpan -i File::ShareDir::Install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/xml-parser.xml:67
#, xml-text
msgid ""
"Finish this temporary workaround by removing /etc/resolv.conf.  A discussion"
" of this file will be made at <xref linkend='resolv.conf'/>"
msgstr ""
"Finalize essa solução temporária removendo /etc/resolv.conf. Uma discussão "
"desse arquivo será feita em <xref linkend='resolv.conf'/>"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/xml-parser.xml:71
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">rm /etc/resolv.conf</userinput>"
msgstr "<userinput remap=\"pre\">rm /etc/resolv.conf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/xml-parser.xml:73
#, xml-text
msgid "Prepare XML::Parser for compilation:"
msgstr "Prepare XML::Parser para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/xml-parser.xml:75
#, no-wrap, xml-text
msgid "<userinput remap=\"configure\">perl Makefile.PL</userinput>"
msgstr "<userinput remap=\"configure\">perl Makefile.PL</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/xml-parser.xml:77
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/xml-parser.xml:79
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/xml-parser.xml:81
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/xml-parser.xml:83
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make test</userinput>"
msgstr "<userinput remap=\"test\">make test</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/xml-parser.xml:85
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/xml-parser.xml:87
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

