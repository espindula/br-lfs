#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/readline.xml:26
#, xml-text
msgid ""
"The Readline package is a set of libraries that offer command-line editing "
"and history capabilities."
msgstr ""
"O pacote Readline é um conjunto de bibliotecas que oferecem recursos de "
"edição de linha de comando e de histórico."

