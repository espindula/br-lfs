#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/e2fsprogs.xml:45
#, xml-text
msgid "Installation of E2fsprogs"
msgstr "Instalação do E2fsprogs"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:47
#, xml-text
msgid ""
"The E2fsprogs documentation recommends that the package be built in a "
"subdirectory of the source tree:"
msgstr ""
"A documentação do E2fsprogs recomenda que o pacote seja construído em um "
"subdiretório da árvore do fonte:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/e2fsprogs.xml:50
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">mkdir -v build\n"
"cd       build</userinput>"
msgstr ""
"<userinput remap=\"pre\">mkdir -v build\n"
"cd      build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:53
#, xml-text
msgid "Prepare E2fsprogs for compilation:"
msgstr "Prepare E2fsprogs para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/e2fsprogs.xml:55
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">../configure --prefix=/usr       \\\n"
"             --sysconfdir=/etc   \\\n"
"             --enable-elf-shlibs \\\n"
"             --disable-libblkid  \\\n"
"             --disable-libuuid   \\\n"
"             --disable-uuidd     \\\n"
"             --disable-fsck</userinput>"
msgstr ""
"<userinput remap=\"configure\">../configure --prefix=/usr       \\\n"
"             --sysconfdir=/etc   \\\n"
"             --enable-elf-shlibs \\\n"
"             --disable-libblkid  \\\n"
"             --disable-libuuid   \\\n"
"             --disable-uuidd     \\\n"
"             --disable-fsck</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/e2fsprogs.xml:64
#, xml-text
msgid "The meaning of the configure options:"
msgstr "O significado das opções do configure:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/e2fsprogs.xml:67
#, xml-text
msgid "<parameter>--enable-elf-shlibs</parameter>"
msgstr "<parameter>--enable-elf-shlibs</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/e2fsprogs.xml:69
#, xml-text
msgid ""
"This creates the shared libraries which some programs in this package use."
msgstr ""
"Isso cria as bibliotecas compartilhadas as quais alguns aplicativos nesse "
"pacote usam."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/e2fsprogs.xml:75
#, xml-text
msgid "<parameter>--disable-*</parameter>"
msgstr "<parameter>--disable-*</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/e2fsprogs.xml:77
#, xml-text
msgid ""
"These prevent building and installing the <systemitem "
"class=\"library\">libuuid</systemitem> and <systemitem "
"class=\"library\">libblkid</systemitem> libraries, the <systemitem "
"class=\"daemon\">uuidd</systemitem> daemon, and the <command>fsck</command> "
"wrapper; util-linux installs more recent versions."
msgstr ""
"Isso evita construir e instalar as bibliotecas <systemitem "
"class=\"library\">libuuid</systemitem> e <systemitem "
"class=\"library\">libblkid</systemitem>, o processo de segundo plano "
"<systemitem class=\"daemon\">uuidd</systemitem> e o encapsulador "
"<command>fsck</command>; util-linux instala versões mais recentes."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:88
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/e2fsprogs.xml:90
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:92
#, xml-text
msgid "To run the tests, issue:"
msgstr "Para executar os testes, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/e2fsprogs.xml:94
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check</userinput>"
msgstr "<userinput remap=\"test\">make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:98
#, xml-text
msgid ""
"One test named <filename>m_assume_storage_prezeroed</filename> is known to "
"fail.  Another test named <filename>m_rootdir_acl</filename> is known to "
"fail if the file system used for the LFS system is not <systemitem "
"class='filesystem'>ext4</systemitem>."
msgstr ""
"Um teste chamado <filename>m_assume_storage_prezeroed</filename> é conhecido"
" por falhar. Outro teste chamado <filename>m_rootdir_acl</filename> é "
"conhecido por falhar se o sistema de arquivos usado para o sistema LFS não "
"for <systemitem class='filesystem'>ext4</systemitem>."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:117
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/e2fsprogs.xml:119
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:121
#, xml-text
msgid "Remove useless static libraries:"
msgstr "Remova bibliotecas estáticas inúteis:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/e2fsprogs.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">rm -fv "
"/usr/lib/{libcom_err,libe2p,libext2fs,libss}.a</userinput>"
msgstr ""
"<userinput remap=\"install\">rm -fv "
"/usr/lib/{libcom_err,libe2p,libext2fs,libss}.a</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:125
#, xml-text
msgid ""
"This package installs a gzipped <filename "
"class=\"extension\">.info</filename> file but doesn't update the system-wide"
" <filename>dir</filename> file. Unzip this file and then update the system "
"<filename>dir</filename> file using the following commands:"
msgstr ""
"Esse pacote instala um arquivo gzipado <filename "
"class=\"extension\">.info</filename>, mas não atualiza o arquivo abrangente "
"ao sistema <filename>dir</filename>. Descompacte esse arquivo e então "
"atualize o arquivo do sistema <filename>dir</filename> usando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/e2fsprogs.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">gunzip -v /usr/share/info/libext2fs.info.gz\n"
"install-info --dir-file=/usr/share/info/dir /usr/share/info/libext2fs.info</userinput>"
msgstr ""
"<userinput remap=\"install\">gunzip -v /usr/share/info/libext2fs.info.gz\n"
"install-info --dir-file=/usr/share/info/dir /usr/share/info/libext2fs.info</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:134
#, xml-text
msgid ""
"If desired, create and install some additional documentation by issuing the "
"following commands:"
msgstr ""
"Se desejado, crie e instale alguma documentação adicional emitindo os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/e2fsprogs.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">makeinfo -o      doc/com_err.info ../lib/et/com_err.texinfo\n"
"install -v -m644 doc/com_err.info /usr/share/info\n"
"install-info --dir-file=/usr/share/info/dir /usr/share/info/com_err.info</userinput>"
msgstr ""
"<userinput remap=\"install\">makeinfo -o      doc/com_err.info ../lib/et/com_err.texinfo\n"
"install -v -m644 doc/com_err.info /usr/share/info\n"
"install-info --dir-file=/usr/share/info/dir /usr/share/info/com_err.info</userinput>"

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/e2fsprogs.xml:143
#, xml-text
msgid "Configuring E2fsprogs"
msgstr "Configurando o E2fsprogs"

#. type: Content of: <sect1><sect2><indexterm><primary>
#: lfs-en/chapter08/e2fsprogs.xml:146
#, xml-text
msgid "/etc/mke2fs.conf"
msgstr "/etc/mke2fs.conf"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:150
#, xml-text
msgid ""
"<filename>/etc/mke2fs.conf</filename> contains the default value of various "
"command line options of <command>mke2fs</command>.  You may edit the file to"
" make the default values suitable for your needs.  For example, some "
"utilities (not in LFS or BLFS) cannot recognize a <systemitem "
"class='filesystem'>ext4</systemitem> file system with "
"<literal>metadata_csum_seed</literal> feature enabled.  <emphasis "
"role='bold'>If</emphasis> you need such a utility, you may remove the "
"feature from the default <systemitem class='filesystem'>ext4</systemitem> "
"feature list with the command:"
msgstr ""
"<filename>/etc/mke2fs.conf</filename> contém o valor padrão de várias opções "
"de linha de comando do <command>mke2fs</command>. Você possivelmente edite o "
"arquivo para tornar os valores padrão convenientes para as tuas "
"necessidades. Por exemplo, alguns utilitários (não no LFS ou no BLFS) não "
"conseguem reconhecer um sistema de arquivos <systemitem "
"class='filesystem'>ext4</systemitem> com o recurso "
"<literal>metadata_csum_seed</literal> habilitado. <emphasis role='bold'>Se</"
"emphasis> você precisar de tal utilitário, você possivelmente remova o "
"recurso da lista padrão de recurso do <systemitem class='filesystem'>ext4</"
"systemitem> com o comando:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/e2fsprogs.xml:162
#, no-wrap, xml-text
msgid ""
"<userinput>sed 's/metadata_csum_seed,//' -i /etc/mke2fs.conf</userinput>"
msgstr ""
"<userinput>sed 's/metadata_csum_seed,//' -i /etc/mke2fs.conf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/e2fsprogs.xml:165
#, xml-text
msgid ""
"Read the man page <ulink role='man' "
"url='&man;mke2fs.conf.5'>mke2fs.conf(5)</ulink> for details."
msgstr ""
"Leia-se a página de manual &quot;<ulink role='man' "
"url='&man;mke2fs.conf.5'>mke2fs.conf(5)</ulink>&quot; para detalhes."

