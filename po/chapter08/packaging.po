#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/packaging.xml:46
#, xml-text
msgid "Installation of Packaging"
msgstr "Instalação do Packaging"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/packaging.xml:48
#, xml-text
msgid "Compile packaging with the following command:"
msgstr "Compile packaging com o seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/packaging.xml:50
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir "
"--no-build-isolation --no-deps $PWD</userinput>"
msgstr ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir "
"--no-build-isolation --no-deps $PWD</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/packaging.xml:52
#, xml-text
msgid "Install packaging with the following command:"
msgstr "Instale packaging com o seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/packaging.xml:54
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"packaging</userinput>"
msgstr ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"packaging</userinput>"

