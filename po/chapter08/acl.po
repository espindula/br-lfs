#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/acl.xml:43
#, xml-text
msgid "Installation of Acl"
msgstr "Instalação do Acl"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/acl.xml:45
#, xml-text
msgid "Prepare Acl for compilation:"
msgstr "Prepare Acl para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/acl.xml:47
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/acl-&acl-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/acl-&acl-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/acl.xml:51
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/acl.xml:53
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/acl.xml:55
#, xml-text
msgid ""
"The Acl tests must be run on a filesystem that supports access controls.  To"
" test the results, issue:"
msgstr ""
"Os testes de Acl precisam ser executados em um sistema de arquivos que "
"suporte controles de acesso. Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/acl.xml:58
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check</userinput>"
msgstr "<userinput remap=\"test\">make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/acl.xml:60
#, xml-text
msgid ""
"One test named <filename>test/cp.test</filename> is known to fail because "
"<application>Coreutils</application> is not built with the "
"<application>Acl</application> support yet."
msgstr ""
"Um teste chamado <filename>test/cp.test</filename> é conhecido por falhar "
"porque <application>Coreutils</application> ainda não foi construído com o "
"suporte de <application>Acl</application>."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/acl.xml:64
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/acl.xml:66
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

