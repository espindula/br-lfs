#~ "mv -v /etc/bash_completion.d/grub /usr/share/bash-completion/completions</userinput>"

#, xml-text
#~ msgid ""
#~ "Fix an issue causing <command>grub-install</command> to fail when the "
#~ "<filename class='directory'>/boot</filename> partition (or the root "
#~ "partition if <filename class='directory'>/boot</filename> is not a separate "
#~ "partition) is created by e2fsprogs-1.47.0 or later:"
#~ msgstr ""
#~ "Corrija um problema que causa <command>grub-install</command> falhar quando "
#~ "a partição <filename class='directory'>/boot</filename> (ou a partição raiz,"
#~ " se <filename class='directory'>/boot</filename> não for uma partição "
#~ "separada) for criada por e2fsprogs-1.47.0 ou posterior:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap='pre'>patch -Np1 -i ../grub-&grub-"
#~ "version;-upstream_fixes-1.patch</userinput>"
#~ msgstr ""
#~ "<userinput remap='pre'>patch -Np1 -i ../grub-&grub-"
#~ "version;-upstream_fixes-1.patch</userinput>"

