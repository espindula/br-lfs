#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/grub.xml:62
#, xml-text
msgid "Installation of GRUB for BIOS"
msgstr "Instalação do GRUB para BIOS"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:66
#, xml-text
msgid "First fix a bug introduced in grub-2.14:"
msgstr "Primeiro corrija um defeito introduzido no grub-2.14:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/grub.xml:68
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed 's/--image-base/--nonexist-linker-option/' -i "
"configure</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed 's/--image-base/--nonexist-linker-option/' -i "
"configure</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:70
#, xml-text
msgid "Prepare GRUB for compilation:"
msgstr "Prepare GRUB para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/grub.xml:72
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-efiemu  \\\n"
"            --disable-werror</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-efiemu  \\\n"
"            --disable-werror</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/grub.xml:78 lfs-en/chapter08/grub.xml:133
#: lfs-en/chapter08/grub.xml:186
#, xml-text
msgid "The meaning of the new configure options:"
msgstr "O significado das novas opções de configuração:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/grub.xml:81
#, xml-text
msgid "<parameter>--disable-werror</parameter>"
msgstr "<parameter>--disable-werror</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/grub.xml:83
#, xml-text
msgid ""
"This allows the build to complete with warnings introduced by more recent "
"versions of Flex."
msgstr ""
"Isso permite que a construção complete com avisos introduzidos por versões "
"mais recentes do Flex."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/grub.xml:89
#, xml-text
msgid "<parameter>--disable-efiemu</parameter>"
msgstr "<parameter>--disable-efiemu</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/grub.xml:91
#, xml-text
msgid ""
"This option minimizes what is built by disabling a feature and eliminating "
"some test programs not needed for LFS."
msgstr ""
"Essa opção minimiza o que é construído desabilitando um recurso e eliminando"
" alguns programas de teste não necessários para o LFS."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:98
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/grub.xml:100 lfs-en/chapter08/grub.xml:157
#: lfs-en/chapter08/grub.xml:203
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:102
#, xml-text
msgid ""
"The test suite for this packages is not recommended.  Most of the tests "
"depend on packages that are not available in the limited LFS environment. To"
" run the tests anyway, run <command>make check</command>."
msgstr ""
"A suíte de teste para esse pacote não é recomendada. A maioria dos testes "
"depende de pacotes que não estão disponíveis no ambiente limitado do LFS. "
"Para executar os testes mesmo assim, execute <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:106
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/grub.xml:108 lfs-en/chapter08/grub.xml:161
#: lfs-en/chapter08/grub.xml:207
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/grub.xml:113
#, xml-text
msgid "Installation of GRUB for 64-bit UEFI"
msgstr "Instalação do GRUB para UEFI de 64 Bits"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:115
#, xml-text
msgid "If you want to boot with 64-bit UEFI, you should build support for it."
msgstr ""
"Se quiser inicializar com UEFI de 64 bits, você deveria construir suporte "
"para ela."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:118
#, xml-text
msgid ""
"First, if you built GRUB from the section above, clean the source tree:"
msgstr ""
"Primeiro, se você construiu o GRUB a partir da seção acima, limpe a árvore "
"do fonte:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/grub.xml:121 lfs-en/chapter08/grub.xml:174
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">make clean</userinput>"
msgstr "<userinput remap=\"pre\">make clean</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:123
#, xml-text
msgid "Now configure GRUB for 64-bit UEFI support:"
msgstr "Agora configure o GRUB para suporte UEFI de 64 bits:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/grub.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr       \\\n"
"            --sysconfdir=/etc   \\\n"
"            --target=x86_64     \\\n"
"            --with-platform=efi \\\n"
"            --disable-efiemu    \\\n"
"            --disable-werror</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr       \\\n"
"            --sysconfdir=/etc   \\\n"
"            --target=x86_64     \\\n"
"            --with-platform=efi \\\n"
"            --disable-efiemu    \\\n"
"            --disable-werror</userinput>"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/grub.xml:136
#, xml-text
msgid "<parameter>--target=x86_64</parameter>"
msgstr "<parameter>--target=x86_64</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/grub.xml:138
#, xml-text
msgid ""
"This defines that the UEFI firmware architecture is x86_64, which GRUB "
"should target."
msgstr ""
"Isso define que a arquitetura do firmware UEFI é x86_64, a qual o GRUB "
"deveria alvejar."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/grub.xml:144
#, xml-text
msgid "<parameter>--with-platform=efi</parameter>"
msgstr "<parameter>--with-platform=efi</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/grub.xml:146
#, xml-text
msgid ""
"This specifies that EFI is a platform GRUB should target.  In combination "
"with <parameter>--target=x86_64</parameter>, GRUB will have the ability to "
"target the <literal>x86_64-efi</literal> platform."
msgstr ""
"Isso especifica que EFI é uma plataforma que o GRUB deveria alvejar. Em "
"combinação com <parameter>--target=x86_64</parameter>, o GRUB terá a "
"capacidade para alvejar a plataforma <literal>x86_64-efi</literal>."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:155
#, xml-text
msgid "Compile the package for 64-bit UEFI support:"
msgstr "Compile o pacote para suporte UEFI de 64 bits:"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:159
#, xml-text
msgid "Install support for 64-bit UEFI:"
msgstr "Instale suporte para UEFI de 64 bits:"

#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/grub.xml:166
#, xml-text
msgid "Installation of GRUB for 32-bit UEFI"
msgstr "Instalação do GRUB para UEFI de 32 Bits"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:168
#, xml-text
msgid ""
"If you want to boot with 32-bit UEFI, which is very rare, you should build "
"support for it."
msgstr ""
"Se quiser inicializar com UEFI de 32 bits, o que é muito raro, você deveria "
"construir suporte para ela."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:171
#, xml-text
msgid ""
"First, if you built GRUB from any of the sections above, clean the source "
"tree:"
msgstr ""
"Primeiro, se você construiu o GRUB a partir de alguma das seções acima, "
"limpe a árvore do fonte:"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:176
#, xml-text
msgid "Now configure GRUB for 32-bit UEFI support:"
msgstr "Agora configure o GRUB para suporte UEFI de 32 bits:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/grub.xml:178
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr       \\\n"
"            --sysconfdir=/etc   \\\n"
"            --target=i386       \\\n"
"            --with-platform=efi \\\n"
"            --disable-efiemu    \\\n"
"            --disable-werror</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr       \\\n"
"            --sysconfdir=/etc   \\\n"
"            --target=i386       \\\n"
"            --with-platform=efi \\\n"
"            --disable-efiemu    \\\n"
"            --disable-werror</userinput>"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/grub.xml:189
#, xml-text
msgid "<parameter>--target=i386</parameter>"
msgstr "<parameter>--target=i386</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/grub.xml:191
#, xml-text
msgid ""
"This defines that the UEFI firmware architecture is i386/32-bit, which GRUB "
"should target. In combination with <parameter>--with-"
"platform=efi</parameter>, GRUB will have the ability to target the "
"<literal>i386-efi</literal> platform."
msgstr ""
"Isso define que a arquitetura de firmware UEFI é i386/32 bits, que o GRUB "
"deveria alvejar. Em combinação com <parameter>--with-"
"platform=efi</parameter>, o GRUB terá a capacidade de alvejar a plataforma "
"<literal>i386-efi</literal>."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:201
#, xml-text
msgid "Compile the package for 32-bit UEFI support:"
msgstr "Compile o pacote para suporte UEFI de 32 bits:"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/grub.xml:205
#, xml-text
msgid "Install support for 32-bit UEFI:"
msgstr "Instale o suporte para UEFI de 32 bits:"

