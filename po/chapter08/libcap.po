#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/libcap.xml:44
#, xml-text
msgid "Installation of Libcap"
msgstr "Instalação do Libcap"

#. type: Content of: <sect1><sect2><note><para>
#: lfs-en/chapter08/libcap.xml:48
#, xml-text
msgid ""
"If updating this package on an existing system and the go compiler is "
"installed, prevent a build error by using <command>export "
"GOLANG=no</command> before running the commands below.  Be sure to unset "
"<envar>GOLANG</envar> after installation is complete."
msgstr ""
"Se atualizar esse pacote em um sistema existente e o compilador Go estiver "
"instalado, evite um erro de construção usando <command>export GOLANG=no</"
"command> antes de executar os comandos abaixo. Certifique-se de "
"desconfigurar <envar>GOLANG</envar> depois que a instalação estiver completa."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libcap.xml:55
#, xml-text
msgid "Prevent static libraries from being installed:"
msgstr "Impeça bibliotecas estáticas de serem instaladas:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libcap.xml:57
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/install -m.*STA/d' "
"libcap/Makefile</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i '/install -m.*STA/d' "
"libcap/Makefile</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libcap.xml:59
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libcap.xml:61
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make prefix=/usr lib=lib</userinput>"
msgstr "<userinput remap=\"make\">make prefix=/usr lib=lib</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/libcap.xml:64
#, xml-text
msgid "The meaning of the make option:"
msgstr "O significado da opção do make:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/libcap.xml:67
#, xml-text
msgid "<parameter>lib=lib</parameter>"
msgstr "<parameter>lib=lib</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/libcap.xml:69
#, xml-text
msgid ""
"This parameter sets the library directory to <filename>/usr/lib</filename> "
"rather than <filename>/usr/lib64</filename> on x86_64. It has no effect on "
"x86."
msgstr ""
"Esse parâmetro configura o diretório de biblioteca para "
"<filename>/usr/lib</filename> em vez de <filename>/usr/lib64</filename> em "
"x86_64. Ele não tem efeito em x86."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libcap.xml:77
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libcap.xml:79
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make test</userinput>"
msgstr "<userinput remap=\"test\">make test</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libcap.xml:81
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libcap.xml:83
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make prefix=/usr lib=lib install</userinput>"
msgstr "<userinput remap=\"install\">make prefix=/usr lib=lib install</userinput>"

