#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/libtool.xml:43
#, xml-text
msgid "Installation of Libtool"
msgstr "Instalação do Libtool"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libtool.xml:45
#, xml-text
msgid "Prepare Libtool for compilation:"
msgstr "Prepare Libtool para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libtool.xml:47
#, no-wrap, xml-text
msgid "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"
msgstr "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libtool.xml:49
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libtool.xml:51
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libtool.xml:53
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libtool.xml:55
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check</userinput>"
msgstr "<userinput remap=\"test\">make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libtool.xml:57
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libtool.xml:59
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/libtool.xml:64
#, xml-text
msgid "Remove a static library only useful for the test suite:"
msgstr "Remova uma biblioteca estática útil somente para a suíte de teste:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/libtool.xml:66
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">rm -fv /usr/lib/libltdl.a</userinput>"
msgstr "<userinput remap=\"install\">rm -fv /usr/lib/libltdl.a</userinput>"

