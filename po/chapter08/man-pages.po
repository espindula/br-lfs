#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/man-pages.xml:41
#, xml-text
msgid "Installation of Man-pages"
msgstr "Instalação das Páginas de Manual"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/man-pages.xml:43
#, xml-text
msgid ""
"Remove two man pages for password hashing functions.  "
"<application>Libxcrypt</application> will provide a better version of these "
"man pages:"
msgstr ""
"Remova duas páginas de manual para funções de resumo de senha. "
"<application>Libxcrypt</application> fornecerá uma versão melhor dessas "
"páginas de manual:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/man-pages.xml:47
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">rm -v man3/crypt*</userinput>"
msgstr "<userinput remap=\"pre\">rm -v man3/crypt*</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/man-pages.xml:49
#, xml-text
msgid "Install Man-pages by running:"
msgstr "Instale as Páginas de Manual executando:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/man-pages.xml:51
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">make -R GIT=false prefix=/usr "
"install</userinput>"
msgstr ""
"<userinput remap=\"install\">make -R GIT=false prefix=/usr "
"install</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/man-pages.xml:54
#, xml-text
msgid "The meaning of the options:"
msgstr "O significado das opções:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/man-pages.xml:58
#, xml-text
msgid "<parameter>-R</parameter>"
msgstr "<parameter>-R</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/man-pages.xml:60
#, xml-text
msgid ""
"This prevents <command>make</command> from setting any built-in variables.  "
"The building system of man-pages does not work well with built-in variables,"
" but currently there is no way to disable them except passing "
"<parameter>-R</parameter> explicitly via the command line."
msgstr ""
"Isso impede que <command>make</command> configure quaisquer variáveis "
"internas. O sistema de construção de páginas de manual não funciona bem com "
"variáveis internas, mas atualmente não existe como desabilitá-las, exceto "
"passando-se <parameter>-R</parameter> explicitamente pela linha de comando."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/man-pages.xml:69
#, xml-text
msgid "<parameter>GIT=false</parameter>"
msgstr "<parameter>GIT=false</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/man-pages.xml:71
#, xml-text
msgid ""
"This prevents the building system from emitting many <computeroutput>git: "
"command not found</computeroutput> warnings lines."
msgstr ""
"Isso evita que o sistema de construção emita muitas linhas de aviso "
"<computeroutput>git: command not found</computeroutput>."

