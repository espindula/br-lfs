#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/intltool.xml:42
#, xml-text
msgid "Installation of Intltool"
msgstr "Instalação do Intltool"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/intltool.xml:44
#, xml-text
msgid "First fix a warning that is caused by perl-5.22 and later:"
msgstr "Primeiro, corrija um aviso que é causado por perl-5.22 e posteriores:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/intltool.xml:46
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">sed -i 's:\\\\\\${:\\\\\\$\\\\{:' intltool-update.in</userinput>"
msgstr "<userinput remap=\"pre\">sed -i 's:\\\\\\${:\\\\\\$\\\\{:' intltool-update.in</userinput>"

#. type: Content of: <sect1><sect2><note><para>
#: lfs-en/chapter08/intltool.xml:48
#, xml-text
msgid ""
"The above regular expression looks unusual because of all the backslashes.  "
"What it does is add a backslash before the right brace character in the "
"sequence '\\${' resulting in '\\$\\{'."
msgstr ""
"A expressão regular acima parece incomum por causa de todas as contra "
"barras. O que ela faz é adicionar uma contra barra antes do carácter abre "
"chave na sequência '\\${' resultando em '\\$\\{'."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/intltool.xml:52
#, xml-text
msgid "Prepare Intltool for compilation:"
msgstr "Prepare Intltool para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/intltool.xml:54
#, no-wrap, xml-text
msgid "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"
msgstr "<userinput remap=\"configure\">./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/intltool.xml:56
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/intltool.xml:58
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/intltool.xml:60
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/intltool.xml:62
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check</userinput>"
msgstr "<userinput remap=\"test\">make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/intltool.xml:64
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/intltool.xml:66
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">make install\n"
"install -v -Dm644 doc/I18N-HOWTO /usr/share/doc/intltool-&intltool-version;/I18N-HOWTO</userinput>"
msgstr ""
"<userinput remap=\"install\">make install\n"
"install -v -Dm644 doc/I18N-HOWTO /usr/share/doc/intltool-&intltool-version;/I18N-HOWTO</userinput>"

