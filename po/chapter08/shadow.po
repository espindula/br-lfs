#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/shadow.xml:26
#, xml-text
msgid ""
"The Shadow package contains programs for handling passwords in a secure way."
msgstr ""
"O pacote Shadow contém aplicativos para manusear senhas de uma maneira "
"segura."

