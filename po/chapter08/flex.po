#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/flex.xml:42
#, xml-text
msgid "Installation of Flex"
msgstr "Instalação do Flex"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/flex.xml:54
#, xml-text
msgid "Prepare Flex for compilation:"
msgstr "Prepare Flex para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/flex.xml:56
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/flex-&flex-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/flex-&flex-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/flex.xml:60
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/flex.xml:62
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/flex.xml:64
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/flex.xml:66
#, no-wrap, xml-text
msgid "<userinput remap=\"test\">make check</userinput>"
msgstr "<userinput remap=\"test\">make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/flex.xml:68
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/flex.xml:70
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/flex.xml:72
#, xml-text
msgid ""
"A few programs do not know about <command>flex</command> yet and try to run "
"its predecessor, <command>lex</command>. To support those programs, create a"
" symbolic link named <filename>lex</filename> that runs "
"<filename>flex</filename> in <command>lex</command> emulation mode, and also"
" create the man page of <command>lex</command> as a symlink:"
msgstr ""
"Uns poucos aplicativos não sabem acerca do <command>flex</command> ainda e "
"tentam executar o predecessor dele, <command>lex</command>. Para suportar "
"esses aplicativos, crie um link simbólico chamado <filename>lex</filename> "
"que executa o <filename>flex</filename> no modo de emulação "
"<command>lex</command>, e também crie a página de manual do "
"<command>lex</command> como um link simbólico:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/flex.xml:79
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">ln -sv flex   /usr/bin/lex\n"
"ln -sv flex.1 /usr/share/man/man1/lex.1</userinput>"
msgstr ""
"<userinput remap=\"install\">ln -sv flex /usr/bin/lex\n"
"ln -sv flex.1 /usr/share/man/man1/lex.1</userinput>"

