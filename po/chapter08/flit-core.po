#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/flit-core.xml:26
#, xml-text
msgid ""
"Flit-core is the distribution-building parts of Flit (a packaging tool for "
"simple Python modules)."
msgstr ""
"Flit-core são as partes de construção de distribuição do Flit (uma "
"ferramenta de empacotamento para módulos simples do Python)."

