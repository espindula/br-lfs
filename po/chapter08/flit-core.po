#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/flit-core.xml:41
#, xml-text
msgid "Installation of Flit-Core"
msgstr "Instalação do Flit-Core"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/flit-core.xml:43
#, xml-text
msgid "Build the package:"
msgstr "Construa o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/flit-core.xml:45
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir --no-build-"
"isolation --no-deps $PWD</userinput>"
msgstr ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir --no-build-"
"isolation --no-deps $PWD</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/flit-core.xml:47
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/flit-core.xml:49
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"flit_core</userinput>"
msgstr ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"flit_core</userinput>"

#. type: Content of: <sect1><sect2><variablelist><title>
#: lfs-en/chapter08/flit-core.xml:52
#, xml-text
msgid "The meaning of the pip3 configuration options and commands:"
msgstr "O significado das opções e comandos de configuração do pip3:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/flit-core.xml:55
#, xml-text
msgid "<command>wheel</command>"
msgstr "<command>wheel</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/flit-core.xml:57
#, xml-text
msgid "This command builds the wheel archive for this package."
msgstr "Esse comando constrói o arquivamento wheel para este pacote."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/flit-core.xml:62
#, xml-text
msgid "<parameter>-w dist</parameter>"
msgstr "<parameter>-w dist</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/flit-core.xml:64
#, xml-text
msgid ""
"Instructs pip to put the created wheel into the <filename "
"class='directory'>dist</filename> directory."
msgstr ""
"Instrui o pip a colocar a roda criada no diretório <filename "
"class='directory'>dist</filename>."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/flit-core.xml:70
#, xml-text
msgid "<parameter>--no-cache-dir</parameter>"
msgstr "<parameter>--no-cache-dir</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/flit-core.xml:72
#, xml-text
msgid ""
"Prevents pip from copying the created wheel into the <filename "
"class='directory'>/root/.cache/pip</filename> directory."
msgstr ""
"Impede que o \"pip\" copie a roda criada para o diretório <filename "
"class='directory'>/root/.cache/pip</filename>."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/flit-core.xml:79
#, xml-text
msgid "<command>install</command>"
msgstr "<command>install</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/flit-core.xml:81
#, xml-text
msgid "This command installs the package."
msgstr "Esse comando instala o pacote."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/flit-core.xml:86
#, xml-text
msgid ""
"<parameter>--no-build-isolation</parameter>, <parameter>--no-"
"deps</parameter>, and <parameter>--no-index</parameter>"
msgstr ""
"<parameter>--no-build-isolation</parameter>, <parameter>--no-"
"deps</parameter> e <parameter>--no-index</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/flit-core.xml:90
#, xml-text
msgid ""
"These options prevent fetching files from the online package repository "
"(PyPI). If packages are installed in the correct order, pip won't need to "
"fetch any files in the first place; these options add some safety in case of"
" user error."
msgstr ""
"Essas opções impedem a busca de arquivos do repositório de pacotes online "
"(PyPI). Se os pacotes fossem instalados na ordem correta, o pip não "
"precisaria buscar nenhum arquivo em primeiro lugar; essas opções adicionam "
"alguma segurança em caso de erro do(a) usuário(a)."

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: lfs-en/chapter08/flit-core.xml:98
#, xml-text
msgid "<parameter>--find-links dist</parameter>"
msgstr "<parameter>--find-links dist</parameter>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: lfs-en/chapter08/flit-core.xml:100
#, xml-text
msgid ""
"Instructs pip to search for wheel archives in the <filename "
"class='directory'>dist</filename> directory."
msgstr ""
"Instrui o pip a procurar por arquivamentos wheel no diretório <filename "
"class='directory'>dist</filename>."

