#: lfs-en/chapter08/automake.xml:42
#, xml-text
msgid "Installation of Automake"
msgstr "Instalação do Automake"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/automake.xml:48
#, xml-text
msgid "Prepare Automake for compilation:"
msgstr "Prepare Automake para compilação:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/automake.xml:50
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"configure\">./configure --prefix=/usr "
"--docdir=/usr/share/doc/automake-&automake-version;</userinput>"
msgstr ""
"<userinput remap=\"configure\">./configure --prefix=/usr "
"--docdir=/usr/share/doc/automake-&automake-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/automake.xml:52
#, xml-text
msgid "Compile the package:"
msgstr "Compile o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/automake.xml:54
#, no-wrap, xml-text
msgid "<userinput remap=\"make\">make</userinput>"
msgstr "<userinput remap=\"make\">make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/automake.xml:56
#, xml-text
msgid ""
"Using four parallel jobs speeds up the tests, even on systems with less "
"logical cores, due to internal delays in individual tests.  To test the "
"results, issue:"
msgstr ""
"Usar-se quatro tarefas paralelas acelera os testes, mesmo em sistemas com "
"menos núcleos lógicos, devido a atrasos internos em testes individuais. Para"
" testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/automake.xml:60
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"test\">make "
"<replaceable>-j$(($(nproc)&gt;4?$(nproc):4))</replaceable> check</userinput>"
msgstr ""
"<userinput remap=\"test\">make "
"<replaceable>-j$(($(nproc)&gt;4?$(nproc):4))</replaceable> check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/automake.xml:62
#, xml-text
msgid ""
"Replace <replaceable>$((...))</replaceable> with the number of logical cores"
" you want to use if you don't want to use all."
msgstr ""
"Substitua &quot;<replaceable>$((...))</replaceable>&quot; pelo número de "
"núcleos lógicos que você deseja usar se não quiser usar todos."

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/automake.xml:65
#, xml-text
msgid "Install the package:"
msgstr "Instale o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/automake.xml:67
#, no-wrap, xml-text
msgid "<userinput remap=\"install\">make install</userinput>"
msgstr "<userinput remap=\"install\">make install</userinput>"

