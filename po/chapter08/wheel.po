#. type: Content of: <sect1><sect2><title>
#: lfs-en/chapter08/wheel.xml:41
#, xml-text
msgid "Installation of Wheel"
msgstr "Instalação da Wheel"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/wheel.xml:43
#, xml-text
msgid "Compile Wheel with the following command:"
msgstr "Compile Wheel com o seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/wheel.xml:45
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir --no-build-"
"isolation --no-deps $PWD</userinput>"
msgstr ""
"<userinput remap=\"make\">pip3 wheel -w dist --no-cache-dir --no-build-"
"isolation --no-deps $PWD</userinput>"

#. type: Content of: <sect1><sect2><para>
#: lfs-en/chapter08/wheel.xml:47
#, xml-text
msgid "Install Wheel with the following command:"
msgstr "Instale Wheel com o seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: lfs-en/chapter08/wheel.xml:49
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"wheel</userinput>"
msgstr ""
"<userinput remap=\"install\">pip3 install --no-index --find-links dist "
"wheel</userinput>"

