      <varlistentry id="sg">
        <term><command>sg</command></term>
        <listitem>
          <para>Executa um comando dado enquanto o GID do(a) usante estiver configurado para
aquele do grupo dado</para>
          <indexterm zone="ch-system-shadow sg">
