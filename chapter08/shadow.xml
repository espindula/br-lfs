        <term><command>groupmod</command></term>
        <listitem>
          <para>É usado para modificar o nome ou GID do grupo dado</para>
          <indexterm zone="ch-system-shadow groupmod">
            <primary sortas="b-groupmod">groupmod</primary>
          </indexterm>
        </listitem>
      </varlistentry>

