<sect1 id="ch-system-mpdecimal" role="wrap">
  <?dbhtml filename="mpdecimal.html"?>

  <sect1info condition="script">
<productname>mpdecimal</productname>
<productnumber>&mpdecimal-version;</productnumber> <address>&mpdecimal-url;</address></sect1info>

  <title>mpdecimal-&mpdecimal-version;</title>

  <indexterm zone="ch-system-mpdecimal">
    <primary sortas="a-Mpdecimal">mpdecimal</primary>
  </indexterm>

  <sect2 role="package">
    <title/>

    <para>
      O pacote mpdecimal contém bibliotecas rápidas C/C++ para aritmética de ponto
flutuante decimal de precisão arbitrária com arredondamento correto.
    </para>

    <segmentedlist>
      <segtitle>&buildtime;</segtitle>
      <segtitle>&diskspace;</segtitle>

      <seglistitem>
        <seg>&mpdecimal-fin-sbu;</seg>
        <seg>&mpdecimal-fin-du;</seg>
      </seglistitem>
    </segmentedlist>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do mpdecimal</title>

    <para>Prepare mpdecimal para compilação:</para>

<screen><userinput remap="configure">./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/mpdecimal-&mpdecimal-version;</userinput></screen>

    <para>Compile o pacote:</para>

<screen><userinput remap="make">make</userinput></screen>

    <para>Para testar os resultados, emita:</para>

<screen><userinput remap="test">make check_local</userinput></screen>

    <para>Instale o pacote:</para>

<screen><userinput remap="install">make install</userinput></screen>

  </sect2>

  <sect2 id="contents-mpdecimal" role="content">
    <title>Conteúdo do mpdecimal</title>

    <segmentedlist>
      <segtitle>Bibliotecas instaladas</segtitle>
      <segtitle>Diretório instalado</segtitle>

      <seglistitem>
        <seg>libmpdec.so e libmpdec++.so</seg>
        <seg>/usr/share/doc/mpdecimal-&mpdecimal-version;</seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Descrições Curtas</bridgehead>
      <?dbfo list-presentation="list"?> <?dbhtml list-presentation="table"?>

      <varlistentry id="libmpdec">
        <term><filename class="libraryfile">libmpdec</filename></term>
        <listitem>
          <para>Contém funções de aritmética de ponto flutuante decimal com precisão
arbitrária para programas em C</para>
          <indexterm zone="ch-system-mpdecimal libmpdec">
            <primary sortas="c-libmpdec">libmpdec</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libmpdecpp">
        <term><filename class="libraryfile">libmpdec++</filename></term>
        <listitem>
          <para>Contém funções de aritmética de ponto flutuante decimal com precisão
arbitrária para programas em C++</para>
          <indexterm zone="ch-system-mpdecimal libmpdecpp">
            <primary sortas="c-libmpdecpp">libmpdec++</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>
  </sect2>

</sect1>
